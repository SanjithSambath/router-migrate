{
  "name": "shell_gpt",
  "lang": "py",
  "python": "3.12",
  "setup": [
    ". scripts/env.sh && .venv/bin/uv venv -q --clear --python 3.12 \"$ENV\"",
    ". scripts/env.sh && .venv/bin/uv pip install -q --python \"$ENV/bin/python\" -e \"$SRC[test]\""
  ],
  "test_cmd": "mkdir -p \"$ENV/home\" \"$ENV/tmp\" && HOME=\"$ENV/home\" TMPDIR=\"$ENV/tmp\" $PY -m pytest -q -p no:cacheprovider -p no:warnings tests/",
  "test_env": {
    "OPENAI_API_KEY": "test_api_key",
    "DEFAULT_TEMPERATURE": "0.0"
  },
  "timeout_s": 900,
  "baseline": {},
  "notes": ""
}