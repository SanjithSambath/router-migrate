{
  "name": "swarm",
  "lang": "py",
  "python": "3.11",
  "setup": [
    ". scripts/env.sh && .venv/bin/uv venv -q --clear --python 3.11 \"$ENV\"",
    ". scripts/env.sh && .venv/bin/uv pip install -q --python \"$ENV/bin/python\" -e \"$SRC\""
  ],
  "test_cmd": "mkdir -p \"$ENV/home\" \"$ENV/tmp\" && HOME=\"$ENV/home\" TMPDIR=\"$ENV/tmp\" $PY -m pytest -q -p no:cacheprovider tests/",
  "test_env": {},
  "timeout_s": 900,
  "baseline": {},
  "notes": ""
}