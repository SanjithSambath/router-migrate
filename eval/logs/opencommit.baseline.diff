diff --git a/src/migrations/03_move_hosted_providers_to_router.ts b/src/migrations/03_move_hosted_providers_to_router.ts
new file mode 100644
index 0000000..5c4cdc0
--- /dev/null
+++ b/src/migrations/03_move_hosted_providers_to_router.ts
@@ -0,0 +1,38 @@
+import {
+  ConfigType,
+  getGlobalConfig,
+  OCO_AI_PROVIDER_ENUM,
+  setGlobalConfig
+} from '../commands/config';
+import { LEGACY_HOSTED_PROVIDERS } from '../utils/provider';
+
+/**
+ * Moves configs from hosted providers (OpenAI, Anthropic, Gemini, ...) to
+ * Router. Router holds the provider credentials, so the stored provider API
+ * key and provider endpoint are deleted. Provider model names are not valid
+ * Router model IDs, so OCO_MODEL is cleared until the user picks a model from
+ * `oco models --refresh` or `oco setup`.
+ */
+export default function () {
+  const globalConfig = getGlobalConfig() as ConfigType;
+  const provider: string | undefined = globalConfig.OCO_AI_PROVIDER;
+
+  const isLegacyHostedProvider =
+    !provider ||
+    (LEGACY_HOSTED_PROVIDERS as readonly string[]).includes(provider);
+
+  if (!isLegacyHostedProvider && provider !== OCO_AI_PROVIDER_ENUM.ROUTER) {
+    return;
+  }
+
+  const migratedConfig: ConfigType = { ...globalConfig };
+  delete migratedConfig.OCO_API_KEY;
+  delete migratedConfig.OCO_API_URL;
+
+  if (isLegacyHostedProvider) {
+    migratedConfig.OCO_AI_PROVIDER = OCO_AI_PROVIDER_ENUM.ROUTER;
+    migratedConfig.OCO_MODEL = '';
+  }
+
+  setGlobalConfig(migratedConfig);
+}
