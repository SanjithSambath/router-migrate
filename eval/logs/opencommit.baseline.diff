diff --git a/test/unit/router.test.ts b/test/unit/router.test.ts
new file mode 100644
index 0000000..6b31428
--- /dev/null
+++ b/test/unit/router.test.ts
@@ -0,0 +1,183 @@
+import { OpenAI } from 'openai';
+import { getConfig } from '../../src/commands/config';
+import { RouterEngine } from '../../src/engine/router';
+import { getEngine } from '../../src/utils/engine';
+import { ROUTER_API_KEY_ENV, ROUTER_BASE_URL } from '../../src/utils/router';
+import { prepareFile } from './utils';
+
+const textResponse = (text: string) => ({
+  output: [
+    {
+      type: 'message',
+      role: 'assistant',
+      content: [{ type: 'output_text', text }]
+    }
+  ]
+});
+
+describe('RouterEngine', () => {
+  const originalRouterKey = process.env[ROUTER_API_KEY_ENV];
+
+  beforeEach(() => {
+    process.env[ROUTER_API_KEY_ENV] = 'test-router-key';
+  });
+
+  afterEach(() => {
+    jest.restoreAllMocks();
+    if (originalRouterKey === undefined) {
+      delete process.env[ROUTER_API_KEY_ENV];
+    } else {
+      process.env[ROUTER_API_KEY_ENV] = originalRouterKey;
+    }
+  });
+
+  const baseConfig = {
+    maxTokensInput: 4096,
+    maxTokensOutput: 256,
+    tokensMaxReasoning: 1024
+  };
+
+  const messages: Array<OpenAI.Chat.Completions.ChatCompletionMessageParam> = [
+    { role: 'system', content: 'system message' },
+    { role: 'user', content: 'example diff' },
+    { role: 'assistant', content: 'example commit' },
+    { role: 'user', content: 'diff --git a/file b/file' }
+  ];
+
+  it('sends a Responses request to Router with the Router key', () => {
+    const engine = new RouterEngine({ ...baseConfig, model: 'test-model' });
+
+    expect(engine.client.baseURL).toBe(ROUTER_BASE_URL);
+    expect(engine.client.apiKey).toBe('test-router-key');
+  });
+
+  it('maps chat messages to instructions and input', async () => {
+    const engine = new RouterEngine({ ...baseConfig, model: 'test-model' });
+    const post = jest
+      .spyOn(engine.client, 'post')
+      .mockResolvedValue(textResponse('feat(router): standard path') as any);
+
+    const result = await engine.generateCommitMessage(messages);
+
+    expect(result).toBe('feat(router): standard path');
+    expect(post).toHaveBeenCalledWith('/responses', {
+      body: {
+        model: 'test-model',
+        instructions: 'system message',
+        input: [
+          { role: 'user', content: 'example diff' },
+          { role: 'assistant', content: 'example commit' },
+          { role: 'user', content: 'diff --git a/file b/file' }
+        ],
+        temperature: 0,
+        top_p: 0.1,
+        max_output_tokens: 256
+      }
+    });
+  });
+
+  it('uses the reasoning budget as max_output_tokens for reasoning models', async () => {
+    const engine = new RouterEngine({
+      ...baseConfig,
+      model: 'test-model',
+      isReasoning: true
+    });
+    const post = jest
+      .spyOn(engine.client, 'post')
+      .mockResolvedValue(textResponse('feat(router): reasoning') as any);
+
+    await engine.generateCommitMessage(messages);
+
+    const body = (post.mock.calls[0][1] as any).body;
+    expect(body.max_output_tokens).toBe(1024);
+    expect(body).not.toHaveProperty('temperature');
+    expect(body).not.toHaveProperty('top_p');
+  });
+
+  it('reads text from message items and skips reasoning items', async () => {
+    const engine = new RouterEngine({ ...baseConfig, model: 'test-model' });
+    jest.spyOn(engine.client, 'post').mockResolvedValue({
+      output: [
+        { type: 'reasoning', summary: [] },
+        {
+          type: 'message',
+          role: 'assistant',
+          content: [
+            { type: 'output_text', text: 'feat(router): ' },
+            { type: 'output_text', text: 'joined' }
+          ]
+        }
+      ]
+    } as any);
+
+    await expect(engine.generateCommitMessage(messages)).resolves.toBe(
+      'feat(router): joined'
+    );
+  });
+
+  it('throws when the model refuses', async () => {
+    const engine = new RouterEngine({ ...baseConfig, model: 'test-model' });
+    jest.spyOn(engine.client, 'post').mockResolvedValue({
+      output: [
+        {
+          type: 'message',
+          role: 'assistant',
+          content: [{ type: 'refusal', refusal: 'no' }]
+        }
+      ]
+    } as any);
+
+    await expect(engine.generateCommitMessage(messages)).rejects.toThrow(
+      /refused/
+    );
+  });
+
+  it('throws TOO_MUCH_TOKENS when input exceeds the token limit boundary', async () => {
+    const engine = new RouterEngine({
+      ...baseConfig,
+      model: 'test-model',
+      isReasoning: true,
+      maxTokensInput: 1024
+    });
+
+    await expect(engine.generateCommitMessage(messages)).rejects.toThrow(
+      /TOO_MUCH_TOKENS/
+    );
+  });
+
+  it('requires a model ID', async () => {
+    const engine = new RouterEngine({ ...baseConfig, model: '' });
+
+    await expect(engine.generateCommitMessage(messages)).rejects.toThrow(
+      /OCO_MODEL is not set/
+    );
+  });
+
+  it('requires RAMP_ROUTER_API_KEY', () => {
+    delete process.env[ROUTER_API_KEY_ENV];
+
+    expect(
+      () => new RouterEngine({ ...baseConfig, model: 'test-model' })
+    ).toThrow(/RAMP_ROUTER_API_KEY is not set/);
+  });
+
+  it('is the default engine and never sends OCO_API_KEY', async () => {
+    const envFile = await prepareFile('.env', '');
+
+    try {
+      const config = getConfig({
+        envPath: envFile.filePath,
+        globalPath: `${envFile.filePath}.missing`
+      });
+      config.OCO_MODEL = 'test-model';
+      config.OCO_API_KEY = 'legacy-provider-key';
+
+      const engine = getEngine(config);
+
+      expect(engine).toBeInstanceOf(RouterEngine);
+      expect((engine as RouterEngine).client.apiKey).toBe('test-router-key');
+    } finally {
+      await envFile.cleanup();
+    }
+  });
+});
