+// Router model IDs can carry a provider prefix (for example `provider:model`),
+// so the reasoning-family check applies after an optional prefix.
+const REASONING_MODEL_PATTERN = /^(?:[^:/]+[:/])?(o[1-9]|gpt-5)/;
+
+/**
+ * Returns true when the model needs a reasoning token budget instead of
+ * sampling settings. OCO_REASONING overrides the automatic detection.
+ */
+export const isReasoningModel = (
+  model: string | undefined,
+  override?: boolean
+): boolean =>
+  typeof override === 'boolean'
+    ? override
+    : REASONING_MODEL_PATTERN.test(model ?? '');
