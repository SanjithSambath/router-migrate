--- /dev/null
+++ b/src/utils/router.ts
@@ -0,0 +1,70 @@
+import { HttpsProxyAgent } from 'https-proxy-agent';
+import { OpenAI } from 'openai';
+
+export const ROUTER_BASE_URL = 'https://api.router.com/v1';
+export const ROUTER_API_KEY_ENV = 'RAMP_ROUTER_API_KEY';
+
+export class RouterApiKeyMissingError extends Error {
+  constructor() {
+    super(
+      `${ROUTER_API_KEY_ENV} is not set. Export your Router API key in ${ROUTER_API_KEY_ENV} before you run oco.`
+    );
+    this.name = 'RouterApiKeyMissingError';
+  }
+}
+
+export const getRouterApiKey = (): string | undefined =>
+  process.env[ROUTER_API_KEY_ENV] || undefined;
+
+export interface RouterClientOptions {
+  baseURL?: string;
+  proxy?: string | null;
+  customHeaders?: Record<string, string>;
+}
+
+/**
+ * Creates an OpenAI SDK client for Router. Router holds the provider
+ * credentials, so the only credential sent is RAMP_ROUTER_API_KEY.
+ */
+export function createRouterClient({
+  baseURL,
+  proxy,
+  customHeaders
+}: RouterClientOptions = {}): OpenAI {
+  const apiKey = getRouterApiKey();
+  if (!apiKey) throw new RouterApiKeyMissingError();
+
+  const clientOptions: OpenAI.ClientOptions = {
+    apiKey,
+    baseURL: baseURL || ROUTER_BASE_URL
+  };
+
+  if (proxy) {
+    clientOptions.httpAgent = new HttpsProxyAgent(proxy);
+  }
+
+  if (customHeaders && Object.keys(customHeaders).length > 0) {
+    clientOptions.defaultHeaders = customHeaders;
+  }
+
+  // The OpenAI SDK's internal fetch may resolve before globalThis.fetch is
+  // available in some Node.js versions, causing premature connection errors.
+  // Binding globalThis.fetch defers resolution to call time.
+  if (typeof globalThis.fetch === 'function') {
+    clientOptions.fetch = (...args) => globalThis.fetch(...args);
+  }
+
+  return new OpenAI(clientOptions);
+}
+
+/**
+ * Lists the model IDs that this Router account can use (GET /v1/models).
+ * Model IDs are account-specific, so this is the only valid source for them.
+ */
+export async function fetchRouterModelIds(
+  options: RouterClientOptions = {}
+): Promise<string[]> {
+  const client = createRouterClient(options);
+  const page = await client.models.list();
+  return page.data.map((model) => model.id).sort();
+}
