diff --git a/src/engine/router.ts b/src/engine/router.ts
new file mode 100644
index 0000000..cc3ed1e
--- /dev/null
+++ b/src/engine/router.ts
@@ -0,0 +1,144 @@
+import { OpenAI } from 'openai';
+import { normalizeEngineError } from '../utils/engineErrorHandler';
+import { GenerateCommitMessageErrorEnum } from '../utils/generateCommitMessageErrors';
+import { isReasoningModel } from '../utils/reasoningModel';
+import { removeContentTags } from '../utils/removeContentTags';
+import { createRouterClient } from '../utils/router';
+import { tokenCount } from '../utils/tokenCount';
+import { AiEngine, AiEngineConfig } from './Engine';
+
+export interface RouterConfig extends AiEngineConfig {}
+
+// The installed OpenAI SDK (4.57) has no typed `responses` resource, so these
+// types cover the subset of the OpenAI Responses schema that this engine uses.
+interface ResponsesInputMessage {
+  role: 'user' | 'assistant';
+  content: string;
+}
+
+interface ResponsesCreateParams {
+  model: string;
+  input: ResponsesInputMessage[];
+  instructions?: string;
+  max_output_tokens: number;
+  temperature?: number;
+  top_p?: number;
+}
+
+interface ResponsesOutputContent {
+  type: string;
+  text?: string;
+  refusal?: string;
+}
+
+interface ResponsesOutputItem {
+  type: string;
+  content?: ResponsesOutputContent[];
+}
+
+interface ResponsesResponse {
+  output?: ResponsesOutputItem[];
+}
+
+/**
+ * Reads the assistant text from `response.output`. Reasoning items and other
+ * non-message items carry no commit message text, so the loop skips them.
+ */
+function extractOutputText(response: ResponsesResponse): string | null {
+  const textParts: string[] = [];
+
+  for (const item of response.output ?? []) {
+    if (item.type !== 'message') continue;
+
+    for (const part of item.content ?? []) {
+      if (part.type === 'refusal') {
+        throw new Error(
+          `Router model refused to generate a commit message: ${part.refusal}`
+        );
+      }
+      if (part.type === 'output_text' && typeof part.text === 'string') {
+        textParts.push(part.text);
+      }
+    }
+  }
+
+  return textParts.length > 0 ? textParts.join('') : null;
+}
+
+export class RouterEngine implements AiEngine {
+  config: RouterConfig;
+  client: OpenAI;
+
+  constructor(config: RouterConfig) {
+    this.config = config;
+    this.client = createRouterClient({
+      baseURL: config.baseURL,
+      proxy: config.proxy,
+      customHeaders: config.customHeaders
+    });
+  }
+
+  public generateCommitMessage = async (
+    messages: Array<OpenAI.Chat.Completions.ChatCompletionMessageParam>
+  ): Promise<string | null> => {
+    const isReasoning = isReasoningModel(
+      this.config.model,
+      this.config.isReasoning
+    );
+    const reasoningTokens = this.config.tokensMaxReasoning || 1000;
+
+    const systemMessages = messages
+      .filter((msg) => msg.role === 'system')
+      .map((msg) => msg.content as string);
+
+    const input = messages
+      .filter((msg) => msg.role !== 'system')
+      .map((msg) => ({
+        role: msg.role as ResponsesInputMessage['role'],
+        content: msg.content as string
+      }));
+
+    const params: ResponsesCreateParams = {
+      model: this.config.model,
+      input,
+      ...(systemMessages.length > 0
+        ? { instructions: systemMessages.join('\n') }
+        : {}),
+      ...(isReasoning
+        ? { max_output_tokens: reasoningTokens }
+        : {
+            temperature: 0,
+            top_p: 0.1,
+            max_output_tokens: this.config.maxTokensOutput
+          })
+    };
+
+    try {
+      if (!this.config.model) {
+        throw new Error(
+          'OCO_MODEL is not set. Run `oco models --refresh` to list the Router model IDs for your account, then run `oco config set OCO_MODEL=<model-id>`.'
+        );
+      }
+
+      const REQUEST_TOKENS = messages
+        .map((msg) => tokenCount(msg.content as string) + 4)
+        .reduce((a, b) => a + b, 0);
+
+      const maxOutputLimit = isReasoning
+        ? reasoningTokens
+        : this.config.maxTokensOutput;
+
+      if (REQUEST_TOKENS > this.config.maxTokensInput - maxOutputLimit)
+        throw new Error(GenerateCommitMessageErrorEnum.tooMuchTokens);
+
+      const response = await this.client.post<
+        ResponsesCreateParams,
+        ResponsesResponse
+      >('/responses', { body: params });
+
+      return removeContentTags(extractOutputText(response), 'think');
+    } catch (error) {
+      throw normalizeEngineError(error, 'router', this.config.model);
+    }
+  };
+}
