diff --git a/mem0/llms/router.py b/mem0/llms/router.py
new file mode 100644
index 00000000..95b279f4
--- /dev/null
+++ b/mem0/llms/router.py
@@ -0,0 +1,241 @@
+"""Shared helpers for sending LLM requests through Ramp's Router.
+
+Router is a gateway that exposes one OpenAI Responses-compatible API
+(``POST /v1/responses``) in front of models from multiple providers. Router holds
+the provider credentials, so the application only ever sends ``RAMP_ROUTER_API_KEY``.
+
+Model IDs are account-specific and must come from ``GET /v1/models``. They are read
+from configuration / environment variables and are never hardcoded here.
+"""
+
+import json
+import os
+from typing import Any, Dict, List, Optional, Tuple
+
+from openai import OpenAI
+
+ROUTER_BASE_URL = "https://api.router.com/v1"
+# Root of the Anthropic Messages compatibility surface (the Anthropic SDK appends ``/v1/messages``).
+ROUTER_ANTHROPIC_BASE_URL = "https://api.router.com"
+
+ROUTER_API_KEY_ENV = "RAMP_ROUTER_API_KEY"
+# Single model ID (from ``GET /v1/models``) used when no ``model`` is configured.
+ROUTER_MODEL_ENV = "RAMP_ROUTER_MODEL"
+# Optional comma-separated ``provider:provider-model`` fallback list (1-15 entries).
+ROUTER_MODELS_ENV = "RAMP_ROUTER_MODELS"
+
+
+def get_router_api_key() -> Optional[str]:
+    return os.getenv(ROUTER_API_KEY_ENV)
+
+
+def resolve_router_model(model: Optional[str]) -> Optional[str]:
+    """Return the configured model, falling back to ``RAMP_ROUTER_MODEL``."""
+    return model or os.getenv(ROUTER_MODEL_ENV) or None
+
+
+def resolve_router_models(models: Optional[List[str]]) -> Optional[List[str]]:
+    """Return the configured fallback list, falling back to ``RAMP_ROUTER_MODELS``."""
+    if models:
+        return list(models)
+    raw = os.getenv(ROUTER_MODELS_ENV)
+    if raw:
+        parsed = [m.strip() for m in raw.split(",") if m.strip()]
+        return parsed or None
+    return None
+
+
+def create_router_client(**client_kwargs):
+    """Build an OpenAI SDK client pointed at Router, authenticated with ``RAMP_ROUTER_API_KEY``."""
+    api_key = get_router_api_key()
+    if not api_key:
+        # Fail loudly: with api_key=None the OpenAI SDK would fall back to OPENAI_API_KEY
+        # and send a provider key to Router.
+        raise ValueError(f"{ROUTER_API_KEY_ENV} is required to call Router.")
+    return OpenAI(api_key=api_key, base_url=ROUTER_BASE_URL, **client_kwargs)
+
+
+def build_router_extra_body(config: Any, models: Optional[List[str]] = None) -> Dict[str, Any]:
+    """Collect Router-only request fields, sent through the SDK's ``extra_body``.
+
+    Fields are only included when explicitly configured so that the request shape
+    is unchanged by default (``allow_flex_tier`` in particular returns 400 for
+    ineligible models).
+    """
+    extra_body: Dict[str, Any] = {}
+    if models:
+        extra_body["models"] = list(models)
+    for attr, key in (
+        ("allow_flex_tier", "allow_flex_tier"),
+        ("provider_timeout", "provider_timeout"),
+        ("timeout_before_headers", "timeout_before_headers"),
+        ("router_metadata", "metadata"),
+    ):
+        value = getattr(config, attr, None)
+        if value is not None:
+            extra_body[key] = value
+    return extra_body
+
+
+def _convert_content(content: Any, role: str) -> Any:
+    """Convert Chat Completions message content into Responses input content."""
+    if content is None:
+        return ""
+    if isinstance(content, str):
+        return content
+
+    parts = content if isinstance(content, list) else [content]
+    text_type = "output_text" if role == "assistant" else "input_text"
+    converted = []
+    for part in parts:
+        if not isinstance(part, dict):
+            converted.append(part)
+            continue
+        part_type = part.get("type")
+        if part_type == "text":
+            converted.append({"type": text_type, "text": part.get("text", "")})
+        elif part_type == "image_url":
+            image = part.get("image_url")
+            url = image.get("url") if isinstance(image, dict) else image
+            detail = (image.get("detail") if isinstance(image, dict) else None) or "auto"
+            converted.append({"type": "input_image", "image_url": url, "detail": detail})
+        else:
+            converted.append(part)
+    return converted
+
+
+def to_responses_input(messages: List[Dict[str, Any]]) -> Tuple[Optional[str], List[Dict[str, Any]]]:
+    """Split Chat Completions ``messages`` into Responses ``instructions`` and ``input``.
+
+    Leading system messages become ``instructions``; everything else keeps its
+    original order in ``input``.
+    """
+    instructions: List[str] = []
+    items: List[Dict[str, Any]] = []
+    for message in messages or []:
+        role = message.get("role")
+        content = message.get("content")
+
+        if role == "system" and not items and isinstance(content, str):
+            instructions.append(content)
+            continue
+
+        if role == "tool":
+            items.append(
+                {
+                    "type": "function_call_output",
+                    "call_id": message.get("tool_call_id"),
+                    "output": content if isinstance(content, str) else json.dumps(content),
+                }
+            )
+            continue
+
+        if role == "assistant" and message.get("tool_calls"):
+            if content:
+                items.append({"role": "assistant", "content": _convert_content(content, role)})
+            for tool_call in message["tool_calls"]:
+                function = tool_call.get("function") or {}
+                items.append(
+                    {
+                        "type": "function_call",
+                        "call_id": tool_call.get("id"),
+                        "name": function.get("name"),
+                        "arguments": function.get("arguments") or "",
+                    }
+                )
+            continue
+
+        items.append({"role": role, "content": _convert_content(content, role)})
+
+    return ("\n\n".join(instructions) if instructions else None), items
+
+
+def to_responses_tools(tools: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
+    """Reshape Chat Completions function tools into Responses function tools (definitions unchanged)."""
+    converted = []
+    for tool in tools:
+        function = tool.get("function") if isinstance(tool, dict) else None
+        if isinstance(tool, dict) and tool.get("type") == "function" and isinstance(function, dict):
+            item = {"type": "function", "name": function.get("name")}
+            if "description" in function:
+                item["description"] = function["description"]
+            if "parameters" in function:
+                item["parameters"] = function["parameters"]
+            # Chat Completions defaults to non-strict tools; Responses defaults to strict.
+            item["strict"] = function.get("strict", False)
+            converted.append(item)
+        else:
+            converted.append(tool)
+    return converted
+
+
+def to_responses_tool_choice(tool_choice: Any) -> Any:
+    if isinstance(tool_choice, dict) and tool_choice.get("type") == "function":
+        function = tool_choice.get("function")
+        if isinstance(function, dict) and "name" in function:
+            return {"type": "function", "name": function["name"]}
+    return tool_choice
+
+
+def to_responses_text_format(response_format: Any) -> Any:
+    """Convert a Chat Completions ``response_format`` into a Responses ``text`` config."""
+    if isinstance(response_format, dict):
+        format_type = response_format.get("type")
+        if format_type == "json_schema" and isinstance(response_format.get("json_schema"), dict):
+            json_schema = response_format["json_schema"]
+            fmt = {"type": "json_schema", "name": json_schema.get("name", "response")}
+            for key in ("schema", "strict", "description"):
+                if key in json_schema:
+                    fmt[key] = json_schema[key]
+            return {"format": fmt}
+        if format_type in ("text", "json_object"):
+            return {"format": {"type": format_type}}
+        return {"format": response_format}
+    return response_format
+
+
+def build_responses_params(chat_params: Dict[str, Any]) -> Dict[str, Any]:
+    """Translate a Chat Completions parameter dict into a Responses request.
+
+    messages -> input / instructions, max_tokens -> max_output_tokens,
+    response_format -> text.format, reasoning_effort -> reasoning.effort.
+    Remaining keys (model, temperature, top_p, store, ...) pass through unchanged.
+    """
+    params = dict(chat_params)
+    request: Dict[str, Any] = {}
+
+    instructions, input_items = to_responses_input(params.pop("messages", []))
+    if instructions is not None:
+        request["instructions"] = instructions
+    request["input"] = input_items
+
+    max_tokens = params.pop("max_tokens", None)
+    max_completion_tokens = params.pop("max_completion_tokens", None)
+    if max_completion_tokens is not None:
+        request["max_output_tokens"] = max_completion_tokens
+    elif max_tokens is not None:
+        request["max_output_tokens"] = max_tokens
+
+    reasoning_effort = params.pop("reasoning_effort", None)
+    if reasoning_effort:
+        request["reasoning"] = {"effort": reasoning_effort}
+
+    response_format = params.pop("response_format", None)
+    if response_format:
+        request["text"] = to_responses_text_format(response_format)
+
+    tools = params.pop("tools", None)
+    if tools:
+        request["tools"] = to_responses_tools(tools)
+    if "tool_choice" in params:
+        tool_choice = params.pop("tool_choice")
+        if tools:
+            request["tool_choice"] = to_responses_tool_choice(tool_choice)
+
+    request.update(params)
+    return request
+
+
+def extract_function_calls(response: Any) -> List[Any]:
+    """Return the ``function_call`` items from a Responses ``output`` list."""
+    return [item for item in (getattr(response, "output", None) or []) if getattr(item, "type", None) == "function_call"]
