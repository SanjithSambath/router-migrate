diff --git a/mem0-ts/src/oss/src/llms/router.ts b/mem0-ts/src/oss/src/llms/router.ts
new file mode 100644
index 00000000..15d1ad22
--- /dev/null
+++ b/mem0-ts/src/oss/src/llms/router.ts
@@ -0,0 +1,156 @@
+/**
+ * Shared helpers for sending LLM requests through Ramp's Router.
+ *
+ * Router is a gateway that exposes one OpenAI Responses-compatible API
+ * (`POST /v1/responses`) in front of models from multiple providers. Router
+ * holds the provider credentials, so the application only ever sends
+ * `RAMP_ROUTER_API_KEY`.
+ *
+ * Model IDs are account-specific and must come from `GET /v1/models`. They are
+ * read from configuration / environment variables and never hardcoded here.
+ */
+import { LLMConfig } from "../types";
+
+export const ROUTER_BASE_URL = "https://api.router.com/v1";
+/** Root of the Anthropic Messages compatibility surface (the SDK appends `/v1/messages`). */
+export const ROUTER_ANTHROPIC_BASE_URL = "https://api.router.com";
+
+export const ROUTER_API_KEY_ENV = "RAMP_ROUTER_API_KEY";
+/** Single model ID (from `GET /v1/models`) used when no `model` is configured. */
+export const ROUTER_MODEL_ENV = "RAMP_ROUTER_MODEL";
+/** Optional comma-separated `provider:provider-model` fallback list (1-15 entries). */
+export const ROUTER_MODELS_ENV = "RAMP_ROUTER_MODELS";
+
+export function getRouterApiKey(): string | undefined {
+  return process.env[ROUTER_API_KEY_ENV] || undefined;
+}
+
+/**
+ * Router key for OpenAI SDK clients. Throws when unset: given an undefined
+ * apiKey, the OpenAI SDK falls back to OPENAI_API_KEY and would send a
+ * provider key to Router.
+ */
+export function requireRouterApiKey(): string {
+  const key = getRouterApiKey();
+  if (!key) {
+    throw new Error(`${ROUTER_API_KEY_ENV} is required to call Router.`);
+  }
+  return key;
+}
+
+export function resolveRouterModel(model?: string): string | undefined {
+  return model || process.env[ROUTER_MODEL_ENV] || undefined;
+}
+
+export function resolveRouterModels(models?: string[]): string[] | undefined {
+  if (models && models.length > 0) return [...models];
+  const raw = process.env[ROUTER_MODELS_ENV];
+  if (!raw) return undefined;
+  const parsed = raw
+    .split(",")
+    .map((m) => m.trim())
+    .filter(Boolean);
+  return parsed.length > 0 ? parsed : undefined;
+}
+
+export function missingRouterModelError(): Error {
+  return new Error(
+    `No Router model configured. Set ${ROUTER_MODEL_ENV} to a model ID returned by ` +
+      "Router's GET /v1/models, or pass `model` (or a `models` fallback list) in the LLM config.",
+  );
+}
+
+/**
+ * Router-only request fields. The OpenAI Node SDK forwards unknown body
+ * fields as-is, which is its equivalent of Python's `extra_body`. Fields are
+ * only included when explicitly configured (`allowFlexTier` returns 400 for
+ * ineligible models, so it is omitted by default).
+ */
+export function buildRouterExtraBody(
+  config: LLMConfig,
+  models?: string[],
+): Record<string, unknown> {
+  const extra: Record<string, unknown> = {};
+  if (models && models.length > 0) extra.models = models;
+  if (config.allowFlexTier != null) extra.allow_flex_tier = config.allowFlexTier;
+  if (config.providerTimeout != null)
+    extra.provider_timeout = config.providerTimeout;
+  if (config.timeoutBeforeHeaders != null)
+    extra.timeout_before_headers = config.timeoutBeforeHeaders;
+  if (config.routerMetadata != null) extra.metadata = config.routerMetadata;
+  return extra;
+}
+
+/**
+ * Split chat-style messages into Responses `instructions` (leading system
+ * messages) and `input` (everything else, in original order).
+ */
+export function toResponsesInput(
+  messages: Array<{ role: string; content: string }>,
+): {
+  instructions?: string;
+  input: Array<{
+    role: "system" | "user" | "assistant";
+    content: string;
+  }>;
+} {
+  const instructions: string[] = [];
+  const input: Array<{
+    role: "system" | "user" | "assistant";
+    content: string;
+  }> = [];
+  for (const msg of messages) {
+    if (msg.role === "system" && input.length === 0) {
+      instructions.push(msg.content);
+      continue;
+    }
+    input.push({
+      role: msg.role as "system" | "user" | "assistant",
+      content: msg.content,
+    });
+  }
+  return {
+    ...(instructions.length > 0 && { instructions: instructions.join("\n\n") }),
+    input,
+  };
+}
+
+/** Reshape Chat Completions function tools into Responses function tools (definitions unchanged). */
+export function toResponsesTools(tools: any[]): any[] {
+  return tools.map((tool) => {
+    if (tool?.type === "function" && tool.function) {
+      return {
+        type: "function",
+        name: tool.function.name,
+        ...(tool.function.description !== undefined && {
+          description: tool.function.description,
+        }),
+        ...(tool.function.parameters !== undefined && {
+          parameters: tool.function.parameters,
+        }),
+        // Chat Completions defaults to non-strict tools; Responses defaults to strict.
+        strict: tool.function.strict ?? false,
+      };
+    }
+    return tool;
+  });
+}
+
+/** Convert a Chat Completions `response_format` into a Responses `text` config. */
+export function toResponsesTextFormat(
+  responseFormat?: { type: string } | null,
+): { format: { type: "text" | "json_object" } } | undefined {
+  if (!responseFormat) return undefined;
+  return {
+    format: { type: responseFormat.type as "text" | "json_object" },
+  };
+}
+
+/** Collect `function_call` items from a Responses `output` array. */
+export function extractToolCalls(
+  output: any[] | undefined,
+): Array<{ name: string; arguments: string }> {
+  return (output || [])
+    .filter((item) => item?.type === "function_call")
+    .map((item) => ({ name: item.name, arguments: item.arguments }));
+}
