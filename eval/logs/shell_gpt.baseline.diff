+def to_responses_tools(functions: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
+    """
+    Convert Chat Completions tool schemas ({"type": "function", "function": {...}})
+    to the flat Responses function tool shape. Definitions themselves are unchanged.
+    """
+    tools = []
+    for schema in functions:
+        function = schema.get("function", schema)
+        tools.append(
+            {
+                "type": "function",
+                "name": function["name"],
+                "description": function.get("description", ""),
+                "parameters": function.get("parameters", {}),
+                # Chat Completions default; Responses defaults to strict mode.
+                "strict": False,
+            }
+        )
+    return tools
+
+
+def to_responses_input(
+    messages: List[Dict[str, Any]],
+) -> tuple[Optional[str], List[Dict[str, Any]]]:
+    """
+    Convert the internally stored chat-style message list into Responses
+    `instructions` (system messages) and `input` items.
+    """
+    instructions: List[str] = []
+    input_items: List[Dict[str, Any]] = []
+    for message in messages:
+        role = message["role"]
+        if role == "system":
+            instructions.append(message["content"])
+        elif role == "tool":
+            input_items.append(
+                {
+                    "type": "function_call_output",
+                    "call_id": message["tool_call_id"],
+                    "output": message["content"],
+                }
+            )
+        elif role == "assistant" and message.get("tool_calls"):
+            if message.get("content"):
+                input_items.append(
+                    {"role": "assistant", "content": message["content"]}
+                )
+            for tool_call in message["tool_calls"]:
+                input_items.append(
+                    {
+                        "type": "function_call",
+                        "call_id": tool_call["id"],
+                        "name": tool_call["function"]["name"],
+                        "arguments": tool_call["function"]["arguments"],
+                    }
+                )
+        else:
+            input_items.append({"role": role, "content": message["content"]})
+    return ("\n\n".join(instructions) or None), input_items
 
 
