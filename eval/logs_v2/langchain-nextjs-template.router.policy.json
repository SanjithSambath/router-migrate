{
 "defaults": {
  "metadata": {
   "product": "langchain-nextjs-template"
  }
 },
 "globs": {
  "**app/ai_sdk/agent/action.*:runAgent": {
   "fallbacks": [
    "gpt-6-luna",
    "claude-haiku-5-5"
   ]
  },
  "**app/ai_sdk/tools/action.*:executeTool": {
   "fallbacks": [
    "gpt-6-luna",
    "claude-haiku-5-5"
   ]
  },
  "**app/api/chat/agents/route.*:POST": {
   "fallbacks": [
    "gpt-6-luna",
    "claude-haiku-5-5"
   ]
  },
  "**app/api/chat/retrieval/route.*:POST": {
   "fallbacks": [
    "gpt-6-luna",
    "claude-haiku-5-5"
   ]
  },
  "**app/api/chat/retrieval_agents/route.*:POST": {
   "fallbacks": [
    "gpt-6-luna",
    "claude-haiku-5-5"
   ]
  },
  "**app/api/chat/route.*:POST": {
   "fallbacks": [
    "gpt-6-luna",
    "claude-haiku-5-5"
   ]
  },
  "**app/api/chat/structured_output/route.*:POST": {
   "fallbacks": [
    "gpt-6-luna",
    "claude-haiku-5-5"
   ]
  },
  "**app/langgraph/agent/agent.*:<module>": {
   "fallbacks": [
    "gpt-6-luna",
    "claude-haiku-5-5"
   ]
  }
 },
 "version": 1
}
