+def _functions_to_tools(specs):
+    """
+    Converts Chat Completions-style function specs (flat name/description/parameters)
+    into Responses API tool definitions. strict is left off (False) since the plugin
+    parameter schemas aren't written to satisfy strict-mode JSON schema rules.
+    """
+    return [
+        {
+            'type': 'function',
+            'name': spec['name'],
+            'description': spec.get('description', ''),
+            'parameters': spec.get('parameters') or {'type': 'object', 'properties': {}},
+            'strict': False,
+        }
+        for spec in specs
+    ]
+
+
+def _to_responses_input(messages):
+    """
+    Converts the stored Chat Completions-style conversation history (role/content dicts,
+    with vision turns using 'text'/'image_url' content parts) into Responses API input
+    items. Function-call items are already stored in native Responses item shape and are
+    passed through unchanged.
+    """
+    items = []
+    for message in messages:
+        if 'type' in message:
+            items.append(message)
+            continue
+        content = message['content']
+        if isinstance(content, str):
+            items.append({'role': message['role'], 'content': content})
+            continue
+        parts = []
+        for part in content:
+            if part['type'] == 'text':
+                parts.append({'type': 'input_text', 'text': part['text']})
+            elif part['type'] == 'image_url':
+                parts.append({
+                    'type': 'input_image',
+                    'image_url': part['image_url']['url'],
+                    'detail': part['image_url'].get('detail', 'auto'),
+                })
+        items.append({'role': message['role'], 'content': parts})
+    return items
+
+
 # Load translations
 parent_dir_path = os.path.join(os.path.dirname(__file__), os.pardir)
 translations_file_path = os.path.join(parent_dir_path, 'translations.json')
