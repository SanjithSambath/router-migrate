+def to_responses_content(content: Any) -> Any:
+    """Chat Completions message content -> Responses input content (text/image_url -> input_text/input_image)."""
+    if isinstance(content, str):
+        return content
+
+    parts = []
+    for part in content:
+        if part["type"] == "text":
+            parts.append(dict(type="input_text", text=part["text"]))
+        elif part["type"] == "image_url":
+            parts.append(dict(type="input_image", image_url=part["image_url"]["url"]))
+
+    return parts
+
