diff --git a/src/router-config.ts b/src/router-config.ts
new file mode 100644
index 0000000..42fdb76
--- /dev/null
+++ b/src/router-config.ts
@@ -0,0 +1,36 @@
+/**
+ * Router (https://api.router.com) is an OpenAI Responses-compatible gateway that fronts
+ * multiple model providers behind one credential. When RAMP_ROUTER_API_KEY is present,
+ * providers that support Router point their traffic there instead of the provider's own
+ * endpoint, and never send the provider's own API key.
+ */
+
+const DEFAULT_ROUTER_BASE_URL = "https://api.router.com/v1";
+
+function readEnv(name: string): string | undefined {
+  // `process` is shimmed to an empty env object in the bundled Obsidian plugin;
+  // this only resolves to a real value in Node-based build/test environments.
+  return typeof process !== "undefined" ? process.env?.[name] : undefined;
+}
+
+export function getRouterApiKey(): string | undefined {
+  return readEnv("RAMP_ROUTER_API_KEY") || undefined;
+}
+
+export function isRouterEnabled(): boolean {
+  return !!getRouterApiKey();
+}
+
+/** Router's base URL, e.g. "https://api.router.com/v1" (OpenAI-SDK style: includes "/v1"). */
+export function getRouterBaseURL(): string {
+  const base = readEnv("RAMP_ROUTER_BASE_URL") || DEFAULT_ROUTER_BASE_URL;
+  return base.endsWith("/") ? base.slice(0, -1) : base;
+}
+
+/**
+ * Base URL for the @anthropic-ai/sdk-flavored clients, which append "/v1/messages"
+ * themselves. getRouterBaseURL() already includes a trailing "/v1", so strip it here.
+ */
+export function getRouterAnthropicBaseURL(): string {
+  return getRouterBaseURL().replace(/\/v1$/, "");
+}
