+
+// SCRATCH -- temporary probe harness for router-migrate; deleted before finishing the migration.
+import LangchainOpenAIChatProvider from "./langchain/openaiChat";
+import LangchainOpenAIAgentProvider from "./langchain/openaiAgent";
+import LangchainChatAnthropicProvider from "./langchain/chatanthropic";
+import LangchainMiniMaxOpenAIProvider, { LangchainMiniMaxAnthropicProvider } from "./langchain/minimaxChat";
+import AnthropicLegacyProvider from "./custom/anthropic";
+import DefaultCustomProvider from "./custom/custom";
+
+function makePlugin() {
+  return {
+    settings: { LLMProviderOptions: {}, api_key: "sk-test-dummy", temperature: 0.7 },
+    getApiKeys: () => [],
+    textGenerator: { proxyService: { getFetch: (_corsBypass) => async (input, init) => fetch(input, init) } },
+    appendThinkingContent: () => {},
+  };
+}
+function sig(ms) { return AbortSignal.timeout ? AbortSignal.timeout(ms) : undefined; }
+async function tryIt(label, fn) {
+  try {
+    const r = await fn();
+    console.log("[probe] " + label + " -> ok", typeof r === "string" ? r.slice(0, 80) : r);
+  } catch (e) {
+    console.log("[probe] " + label + " -> err", (e && e.message) || e);
+  }
+}
+
+async function main() {
+  {
+    const plugin = makePlugin();
+    const p = new LangchainOpenAIChatProvider({ plugin, config: {} });
+    await p.load();
+    await tryIt("openaiChat", () => p.generate([{ role: "user", content: "say hi" }],
+      { api_key: "sk-test-dummy", model: "gpt-4o", max_tokens: 16, stream: false, otherOptions: {}, requestParams: { signal: sig(4000) } }));
+  }
+  {
+    const plugin = makePlugin();
+    const p = new LangchainOpenAIAgentProvider({ plugin, config: {} });
+    await p.load();
+    await tryIt("openaiAgent", () => p.generate([{ role: "user", content: "say hi" }],
+      { api_key: "sk-test-dummy", model: "o1-mini", max_tokens: 16, stream: false, otherOptions: {}, requestParams: { signal: sig(4000) } }));
+  }
+  {
+    const plugin = makePlugin();
+    const p = new LangchainChatAnthropicProvider({ plugin, config: {} });
+    await p.load();
+    await tryIt("chatAnthropic", () => p.generate([{ role: "user", content: "say hi" }],
+      { api_key: "sk-test-dummy", model: "claude-3-5-sonnet-latest", max_tokens: 16, stream: false, otherOptions: {}, requestParams: { signal: sig(4000) } }));
+  }
+  {
+    const plugin = makePlugin();
+    const p = new AnthropicLegacyProvider({ plugin, config: {} });
+    await tryIt("customAnthropicLegacy", () => p.generate([{ role: "user", content: "say hi" }],
+      { api_key: "sk-test-dummy", max_tokens: 16, stream: false, requestParams: { signal: sig(4000) } }));
+  }
+  {
+    const plugin = makePlugin();
+    const p = new DefaultCustomProvider({ plugin, config: {} });
+    await tryIt("customDefault", () => p.generate([{ role: "user", content: "say hi" }],
+      { api_key: "sk-test-dummy", max_tokens: 16, stream: false, requestParams: { signal: sig(4000) } }));
+  }
+  {
+    const plugin = makePlugin();
+    const p = new LangchainMiniMaxOpenAIProvider({ plugin, config: {} });
+    await p.load();
+    await tryIt("minimaxOpenAI", () => p.generate([{ role: "user", content: "say hi" }],
+      { api_key: "sk-test-dummy", model: "MiniMax-M3", basePath: "https://api.minimax.io/v1", max_tokens: 16, stream: false, otherOptions: {}, requestParams: { signal: sig(4000) } }));
+  }
+  {
+    const plugin = makePlugin();
+    const p = new LangchainMiniMaxAnthropicProvider({ plugin, config: {} });
+    await p.load();
+    await tryIt("minimaxAnthropic", () => p.generate([{ role: "user", content: "say hi" }],
+      { api_key: "sk-test-dummy", model: "MiniMax-M3", basePath: "https://api.minimax.io/anthropic", max_tokens: 16, stream: false, otherOptions: {}, requestParams: { signal: sig(4000) } }));
+  }
+}
+
+main().then(() => process.exit(0)).catch((e) => { console.error("FATAL", e); process.exit(1); });
