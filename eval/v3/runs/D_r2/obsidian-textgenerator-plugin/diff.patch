+  // (LangchainBase.getLLM): configuration.fetch = routerFetch(proxyFetch).
+  await tryIt("openaiChat gpt-4o", async () => {
+    const llm = new ChatOpenAI({
+      apiKey: "sk-test-dummy", model: "gpt-4o", maxTokens: 16, maxRetries: 0,
+      configuration: { baseURL: "https://api.openai.com/v1", fetch: routerFetch(fetch), dangerouslyAllowBrowser: true },
+    });
+    return (await llm.invoke("say hi", { signal: sig(4000) })).content;
+  });
+
+  await tryIt("openaiAgent o1-mini (model_map -> o3-mini)", async () => {
+    const llm = new ChatOpenAI({
+      apiKey: "sk-test-dummy", model: "o1-mini", maxRetries: 0,
+      configuration: { baseURL: "https://api.openai.com/v1", fetch: routerFetch(fetch), dangerouslyAllowBrowser: true },
+    });
+    return (await llm.invoke("say hi", { signal: sig(4000) })).content;
+  });
+
+  await tryIt("minimax-openai MiniMax-M3 (unlocked host)", async () => {
