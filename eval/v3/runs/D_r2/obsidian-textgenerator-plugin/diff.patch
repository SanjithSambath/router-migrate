+  // custom/base.tsx & custom/custom.tsx CustomProvider.request(): fetchImpl = routerFetch(baseFetch).
+  await tryIt("custom default (openai chat.completions shape, model_map gpt-3.5-turbo-16k -> gpt-3.5-turbo)", async () => {
+    const fetchImpl = routerFetch(fetch);
+    const res = await fetchImpl("https://api.openai.com/v1/chat/completions", {
+      method: "POST",
+      headers: { "Content-Type": "application/json", authorization: "Bearer sk-test-dummy" },
+      body: JSON.stringify({ model: "gpt-3.5-turbo-16k", temperature: 0.7, max_tokens: 16, n: 1, stream: false, messages: [{ role: "user", content: "say hi" }] }),
+      signal: sig(4000),
+    });
+    return { status: res.status, body: await res.text() };
+  });
+
+  // custom/anthropic.tsx AnthropicLegacyProvider.request() (inherited): same fetchImpl.
+  await tryIt("custom anthropic legacy (anthropic messages shape, model_map claude-2.1 -> claude-haiku-4-5)", async () => {
+    const fetchImpl = routerFetch(fetch);
+    const res = await fetchImpl("https://api.anthropic.com/v1/messages", {
+      method: "POST",
+      headers: { "anthropic-version": "2023-06-01", "Content-Type": "application/json", "x-api-key": "sk-test-dummy" },
+      body: JSON.stringify({ model: "claude-2.1", stream: false, max_tokens: 16, messages: [{ role: "user", content: "say hi" }] }),
+      signal: sig(4000),
+    });
+    return { status: res.status, body: await res.text() };
+  });
+
+  // a non-matching custom endpoint must stay untouched (passthrough proof).
+  await tryIt("custom provider pointed at a self-hosted endpoint (must NOT route)", async () => {
+    const fetchImpl = routerFetch(fetch);
+    const res = await fetchImpl("http://127.0.0.1:1/v1/chat/completions", {
+      method: "POST",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify({ model: "llama3", messages: [{ role: "user", content: "hi" }] }),
+      signal: sig(1500),
+    });
+    return { status: res.status };
+  });
+}
+
+main().then(() => process.exit(0)).catch((e) => { console.error("FATAL", e); process.exit(1); });
