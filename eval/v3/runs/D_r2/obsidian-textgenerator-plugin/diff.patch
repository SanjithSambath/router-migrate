+      apiKey: "sk-test-dummy", model: "MiniMax-M3", maxTokens: 16, maxRetries: 0,
+      configuration: { baseURL: "https://api.minimax.io/v1", fetch: routerFetch(fetch), dangerouslyAllowBrowser: true },
+    });
+    return (await llm.invoke("say hi", { signal: sig(4000) })).content;
+  });
+
+  // chatanthropic.tsx's new getLLM override: clientOptions.fetch = routerFetch(proxyFetch).
+  await tryIt("chatAnthropic claude-3-5-sonnet-latest (model_map -> sonnet-4-5)", async () => {
+    const llm = new ChatAnthropic({
+      apiKey: "sk-test-dummy", model: "claude-3-5-sonnet-latest", maxTokens: 16, maxRetries: 0,
+      clientOptions: { baseURL: "https://api.anthropic.com", fetch: routerFetch(fetch), dangerouslyAllowBrowser: true },
+    });
+    return (await llm.invoke("say hi", { signal: sig(4000) })).content;
+  });
+
+  // minimaxChat.tsx's Anthropic variant: clientOptions.fetch = wrapMiniMaxAnthropicFetch(routerFetch(fetchImpl)).
+  await tryIt("minimax-anthropic MiniMax-M3 (unlocked host)", async () => {
+    const llm = new ChatAnthropic({
+      apiKey: "sk-test-dummy", model: "MiniMax-M3", maxTokens: 16, maxRetries: 0,
+      clientOptions: { baseURL: "https://api.minimax.io/anthropic", fetch: routerFetch(fetch), dangerouslyAllowBrowser: true },
+    });
+    return (await llm.invoke("say hi", { signal: sig(4000) })).content;
+  });
