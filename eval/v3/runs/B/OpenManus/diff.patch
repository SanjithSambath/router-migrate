+    @staticmethod
+    def _to_responses_content(content: Union[str, List[dict]]) -> Union[str, List[dict]]:
+        """Convert chat-style message content into Responses API input content parts."""
+        if isinstance(content, str):
+            return content
+        parts = []
+        for item in content:
+            if isinstance(item, str):
+                parts.append({"type": "input_text", "text": item})
+            elif item.get("type") == "image_url":
+                parts.append(
+                    {
+                        "type": "input_image",
+                        "image_url": item["image_url"]["url"],
+                        "detail": "auto",
+                    }
+                )
+            else:  # {"type": "text", "text": ...}
+                parts.append({"type": "input_text", "text": item.get("text", "")})
+        return parts
+
+    @classmethod
+    def _to_responses_input(cls, messages: List[dict]) -> tuple:
+        """Split chat-style messages into (instructions, input) for the Responses API.
+
+        System messages become `instructions`; tool-role messages and assistant
+        tool_calls become the dedicated `function_call_output`/`function_call` item
+        types the Responses API uses instead of chat's role="tool" messages.
+        """
+        instructions_parts = []
+        input_items = []
+
+        for message in messages:
+            role = message["role"]
+
+            if role == "system":
+                if message.get("content"):
+                    instructions_parts.append(message["content"])
+                continue
+
+            if role == "tool":
+                input_items.append(
+                    {
+                        "type": "function_call_output",
+                        "call_id": message["tool_call_id"],
+                        "output": message.get("content") or "",
+                    }
+                )
+                continue
+
+            content = message.get("content")
+            if content:
+                input_items.append(
+                    {"role": role, "content": cls._to_responses_content(content)}
+                )
+
+            for tool_call in message.get("tool_calls") or []:
+                function = tool_call["function"]
+                input_items.append(
+                    {
+                        "type": "function_call",
+                        "call_id": tool_call["id"],
+                        "name": function["name"],
+                        "arguments": function["arguments"],
+                    }
+                )
+
+        instructions = "\n\n".join(instructions_parts) if instructions_parts else None
+        return instructions, input_items
+
+    @staticmethod
+    def _to_responses_tools(tools: Optional[List[dict]]) -> Optional[List[dict]]:
+        """Flatten chat-completions-shaped tool defs into the Responses API's flat shape."""
+        if not tools:
+            return tools
+        converted = []
+        for tool in tools:
+            if tool.get("type") == "function" and "function" in tool:
+                function = tool["function"]
+                converted.append(
+                    {
+                        "type": "function",
+                        "name": function["name"],
+                        "description": function.get("description", ""),
+                        "parameters": function.get("parameters", {}),
+                        # Responses function tools default to strict=true (requiring
+                        # additionalProperties:false and every property in `required`),
+                        # unlike chat.completions. These tool defs predate that rule, so
+                        # opt back out of strict mode rather than rewriting the schemas.
+                        "strict": False,
+                    }
