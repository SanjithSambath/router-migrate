@@ -0,0 +1,68 @@
+import { describe, it, expect } from "vitest";
+
+const baseURL = "https://router.test/v1";
+
+describe("Router provider wiring", () => {
+  it("sends chat requests to POST {baseURL}/responses with a Router bearer token and no provider key", async () => {
+    const { ChatOpenAI } = await import("@langchain/openai");
+
+    let captured: { url: string; headers: Headers; body: Record<string, any> } | undefined;
+    const captureFetch = async (input: RequestInfo | URL, init?: RequestInit) => {
+      captured = {
+        url: String(input),
+        headers: new Headers(init?.headers),
+        body: JSON.parse(String(init?.body || "{}")),
+      };
+      throw new Error("capture-complete");
+    };
+
+    const llm = new ChatOpenAI({
+      apiKey: "rm-router-test-key",
+      model: "claude-haiku-5-5",
+      maxTokens: 16,
+      maxRetries: 0,
+      useResponsesApi: true,
+      configuration: { baseURL, fetch: captureFetch, dangerouslyAllowBrowser: true },
+    });
+
+    try {
+      await llm.invoke("Hello");
+    } catch {
+      expect(captured).toBeDefined();
+    }
+
+    const request = captured!;
+    expect(request.url).toBe(`${baseURL}/responses`);
+    expect(request.headers.get("authorization")).toBe("Bearer rm-router-test-key");
+    expect(request.body).toMatchObject({
+      model: "claude-haiku-5-5",
+      max_output_tokens: 16,
+    });
+    expect(JSON.stringify(request.body)).not.toMatch(/sk-|anthropic|AIza/i);
+  });
+
+  it("lists models from GET {baseURL}/models with a Router bearer token", async () => {
+    const OpenAI = (await import("openai")).default;
+
+    let captured: { url: string; headers: Headers } | undefined;
+    const captureFetch = async (input: RequestInfo | URL, init?: RequestInit) => {
+      captured = { url: String(input), headers: new Headers(init?.headers) };
+      return new Response(JSON.stringify({ data: [] }), {
+        status: 200,
+        headers: { "content-type": "application/json" },
+      });
+    };
+
+    const client = new OpenAI({
+      apiKey: "rm-router-test-key",
+      baseURL,
+      fetch: captureFetch as any,
+    });
+
+    await client.models.list();
+
+    const request = captured!;
+    expect(request.url).toBe(`${baseURL}/models`);
+    expect(request.headers.get("authorization")).toBe("Bearer rm-router-test-key");
+  });
+});
diff --git a/src/LLMProviders/langchain/router.tsx b/src/LLMProviders/langchain/router.tsx
