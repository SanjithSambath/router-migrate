diff --git a/computer_use_demo/gui_agent/llm_utils/router_client.py b/computer_use_demo/gui_agent/llm_utils/router_client.py
new file mode 100644
index 0000000..3e68639
--- /dev/null
+++ b/computer_use_demo/gui_agent/llm_utils/router_client.py
@@ -0,0 +1,47 @@
+"""
+Shared configuration for talking to Router (https://api.router.com/v1) instead
+of calling LLM providers directly. Router holds the provider credentials, so
+callers only ever need RAMP_ROUTER_API_KEY.
+"""
+import os
+
+from openai import OpenAI
+
+DEFAULT_ROUTER_BASE_URL = "https://api.router.com/v1"
+
+
+def get_router_base_url() -> str:
+    return os.environ.get("RAMP_ROUTER_BASE_URL", DEFAULT_ROUTER_BASE_URL)
+
+
+def get_router_api_key() -> str:
+    api_key = os.environ.get("RAMP_ROUTER_API_KEY")
+    if not api_key:
+        raise ValueError("RAMP_ROUTER_API_KEY is not set")
+    return api_key
+
+
+def get_router_client() -> OpenAI:
+    """OpenAI Responses client pointed at Router."""
+    return OpenAI(base_url=get_router_base_url(), api_key=get_router_api_key())
+
+
+def get_router_anthropic_base_url() -> str:
+    """The Anthropic SDK appends '/v1/messages' itself, so it needs the base
+    URL without the '/v1' suffix that the Responses client uses."""
+    base_url = get_router_base_url()
+    if base_url.endswith("/v1"):
+        return base_url[: -len("/v1")]
+    return base_url
+
+
+def get_router_model(env_var: str) -> str:
+    """Router model ids are account-specific (from GET /v1/models), so they
+    must come from configuration rather than being hardcoded at call sites."""
+    model = os.environ.get(env_var)
+    if not model:
+        raise ValueError(
+            f"{env_var} is not set. Set it to a Router model id "
+            f"(see GET {get_router_base_url()}/models)."
+        )
+    return model
