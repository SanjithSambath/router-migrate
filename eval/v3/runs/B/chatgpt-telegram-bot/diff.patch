+    def __to_responses_content(content):
+        """
+        Converts stored message content (a plain string, or a list of Chat-Completions-style
+        {'type': 'text'|'image_url', ...} parts) into Responses input content parts.
+        """
+        if isinstance(content, str):
+            return content
+        parts = []
+        for part in content:
+            if part['type'] == 'image_url':
+                parts.append({
+                    'type': 'input_image',
+                    'image_url': part['image_url']['url'],
+                    'detail': part['image_url'].get('detail', 'auto'),
+                })
+            else:
+                parts.append({'type': 'input_text', 'text': part['text']})
+        return parts
+
+    @classmethod
+    def __to_responses_input(cls, messages):
+        """
+        Converts the stored conversation history (excluding the leading system/instructions
+        entry) into a Responses `input` list. function_call / function_call_output entries are
+        already stored in their native Responses shape and are passed through unchanged.
+        """
+        items = []
+        for message in messages:
+            if 'type' in message:
+                items.append(message)
+            else:
+                items.append({'role': message['role'], 'content': cls.__to_responses_content(message['content'])})
+        return items
