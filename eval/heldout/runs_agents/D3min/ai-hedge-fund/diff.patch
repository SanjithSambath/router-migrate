 )
+try:  # router-migrate: route LLM traffic through Ramp's Router when RAMP_ROUTER_API_KEY is set
+    from ..router_runtime import wrap_langchain as _router_wrap_langchain, wrap_openai as _router_wrap_openai
+except ImportError:  # router-migrate: module executed as a script
+    try:
+        from router_runtime import wrap_langchain as _router_wrap_langchain, wrap_openai as _router_wrap_openai
+    except ImportError:  # router-migrate: runtime not importable from here; this module keeps its original behavior
+        _router_wrap_langchain = lambda c, *a, **k: c  # noqa: E731
+        _router_wrap_openai = lambda c, *a, **k: c  # noqa: E731
+
+
+def _router_wrap_vendor_openai(chat, host):
+    """router-migrate: wrap_langchain(), plus unlocking `host` so this OpenAI-compatible vendor's traffic can
+    reach Router for models in Router's catalog. wrap_langchain() has no unlock_hosts parameter, so every SDK
+    client it would find (same attribute walk: langchain_xai/langchain_deepseek build `.client`'s embedded
+    OpenAI client separately from `.root_client` — both need unlocking) is unlocked directly here instead."""
+    _router_wrap_langchain(chat)
+    seen = []
+    for attr in ("root_client", "root_async_client", "_client", "_async_client", "client", "async_client"):
+        base = getattr(chat, attr, None)
+        for cand in (base, getattr(base, "_client", None)):
+            if cand is None or any(cand is x for x in seen):
+                continue
+            seen.append(cand)
+            _router_wrap_openai(cand, unlock_hosts=[host])
+    return chat
 
 DEFAULT_MODEL = "claude-opus-5-5"
 
