+try:  # router-migrate: route LLM traffic through Ramp's Router when RAMP_ROUTER_API_KEY is set
+    from ..router_runtime import wrap_langchain as _router_wrap_langchain
+    from ..router_runtime import wrap_openai as _router_wrap_openai
+except ImportError:  # router-migrate: module executed as a script
+    try:
+        from router_runtime import wrap_langchain as _router_wrap_langchain
+        from router_runtime import wrap_openai as _router_wrap_openai
+    except ImportError:  # router-migrate: runtime not importable from here; this module keeps its original behavior
+        _router_wrap_langchain = lambda c, *a, **k: c  # noqa: E731
+        _router_wrap_openai = lambda c, *a, **k: c  # noqa: E731
+
+
+def _router_unlock_vendor_host(chat, host):
+    """wrap_langchain() can't carry unlock_hosts through to the client(s) it
+    finds, so vendor-hosted OpenAI-wire clients (xAI, Kimi/Moonshot, ...) are
+    unlocked directly here instead. langchain-openai builds the sync chat
+    completions resource from a *separate* OpenAI client than root_client, so
+    both (all of root_client/root_async_client/client/async_client, really)
+    need unlocking -- mirrors router_runtime.wrap_langchain's own traversal."""
+    seen = []
+    for attr in ("root_client", "root_async_client", "_client", "_async_client", "client", "async_client"):
+        c = getattr(chat, attr, None)
+        for cand in (c, getattr(c, "_client", None)):
+            if cand is None or any(cand is x for x in seen):
+                continue
+            seen.append(cand)
+            _router_wrap_openai(cand, unlock_hosts=[host])
+    return chat
 
