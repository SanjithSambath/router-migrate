{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VHMQqsCjZE3RBzarFdXKkN","type":"tool_result","content":"1\timport os\n2\timport sys\n3\tfrom typing import Any, ClassVar, cast\n4\t\n5\timport inquirer\n6\tfrom rich.console import Console\n7\t\n8\tfrom vibegit.config import CONFIG_PATH, Config, ModelConfig\n9\t\n10\tconsole = Console()\n11\t\n12\t\n13\tclass ConfigWizard:\n14\t    \"\"\"Interactive configuration wizard for VibeGit.\n15\t\n16\t    Shows up when users start VibeGit for the first time,\n17\t    asking for essential configuration values like the LLM model and API keys.\n18\t    \"\"\"\n19\t\n20\t    CUSTOM_PYDANTIC_AI_OPTION = \"Custom model (<provider>:<model> format, see https://ai.pydantic.dev/api/models/base/)\"\n21\t    CUSTOM_OPENAI_OPTION = \"Custom model (OpenAI API compatible)\"\n22\t\n23\t    # Model presets with friendly names and their Pydantic AI provider:model format\n24\t    MODEL_PRESETS: ClassVar[dict[str, str]] = {\n25\t        \"Gemini 3.7 Flash (Recommended)\": \"google:gemini-3.8-flash\",\n26\t        \"Gemini 3.5 Flash-Lite (Fast and cost-efficient)\": \"google:gemini-3.5-flash-lite\",\n27\t        \"Gemini 3.1 Pro (Preview)\": \"google:gemini-3.1-pro-preview\",\n28\t        \"GPT-5.6 Terra (Balanced)\": \"openai:gpt-5.6-terra\",\n29\t        \"GPT-5.6 Sol (Highest quality)\": \"openai:gpt-5.6-sol\",\n30\t        \"GPT-5.6 Luna (High volume)\": \"openai:gpt-5.6-luna\",\n31\t        CUSTOM_OPENAI_OPTION: \"custom_openai\",\n32\t        CUSTOM_PYDANTIC_AI_OPTION: \"custom\",\n33\t    }\n34\t\n35\t    # Map model name prefixes to their API key environment variables\n36\t    MODEL_TO_API_KEY_ENV: ClassVar[dict[str, str]] = {\n37\t        \"google\": \"GOOGLE_API_KEY\",\n38\t        \"google-gla\": \"GOOGLE_API_KEY\",\n39\t        \"google_genai\": \"GOOGLE_API_KEY\",\n40\t        \"openai\": \"OPENAI_API_KEY\",\n41\t        \"grok\": \"GROK_API_KEY\",\n42\t        \"xai\": \"GROK_API_KEY\",\n43\t    }\n44\t\n45\t    def __init__(self):\n46\t        self.config = Config()\n47\t\n48\t    @staticmethod\n49\t    def _prompt(questions: list[Any]) -> dict[str, Any]:\n50\t        answers = inquirer.prompt(questions)\n51\t        if answers is None:\n52\t            raise KeyboardInterrupt\n53\t        return cast(dict[str, Any], answers)\n54\t\n55\t    def run(self):\n56\t        \"\"\"Run the interactive configuration wizard.\"\"\"\n57\t        console.print(\"[bold blue]VibeGit Configuration Wizard[/bold blue]\")\n58\t        console.print(\"Let's set up VibeGit for first use.\\n\")\n59\t\n60\t        try:\n61\t            self._configure_model()\n62\t            self._configure_api_keys()\n63\t            self._save_config()\n64\t        except KeyboardInterrupt:\n65\t            console.print(\"\\n[yellow]Configuration cancelled.[/yellow]\")\n66\t            raise SystemExit(130) from None\n67\t\n68\t        console.print(\n69\t            \"\\n[bold green]Configuration complete! VibeGit is ready to use.[/bold green]\"\n70\t        )\n71\t\n72\t    def _configure_model(self):\n73\t        \"\"\"Configure the LLM model to use.\"\"\"\n74\t        console.print(\"[bold]LLM Model Configuration[/bold]\")\n75\t        console.print(\"Choose which AI model to use for generating commit proposals:\")\n76\t\n77\t        # Create choices for the model selection\n78\t        model_choices = list(self.MODEL_PRESETS.keys())\n79\t\n80\t        questions = [\n81\t            inquirer.List(\n82\t                \"model_choice\",\n83\t                message=\"Select an LLM model:\",\n84\t                choices=model_choices,\n85\t                default=model_choices[0],\n86\t            ),\n87\t        ]\n88\t\n89\t        answers = self._prompt(questions)\n90\t        model_choice = answers.get(\"model_choice\")\n91\t\n92\t        if not isinstance(model_choice, str) or model_choice not in self.MODEL_PRESETS:\n93\t            raise KeyboardInterrupt\n94\t\n95\t        if model_choice == self.CUSTOM_PYDANTIC_AI_OPTION:\n96\t            custom_model = self._get_custom_model()\n97\t            self.config.model = ModelConfig(name=custom_model)\n98\t        elif model_choice == self.CUSTOM_OPENAI_OPTION:\n99\t            openai_custom = self._get_openai_compatible_model()\n100\t            self.config.model = ModelConfig(\n101\t                name=openai_custom[\"model_name\"],\n102\t                base_url=openai_custom[\"base_url\"],\n103\t                api_key=openai_custom[\"api_key\"],\n104\t                model_provider=\"openai\",\n105\t            )\n106\t        else:\n107\t            self.config.model = ModelConfig(name=self.MODEL_PRESETS[model_choice])\n108\t\n109\t        console.print(f\"[green]Model set to: {self.config.model.name}[/green]\")\n110\t\n111\t    def _get_custom_model(self) -> str:\n112\t        \"\"\"Prompt for a custom model name.\"\"\"\n113\t        questions = [\n114\t            inquirer.Text(\n115\t                \"custom_model\",\n116\t                message=\"Enter the model name in Pydantic AI <provider>:<model> format\",\n117\t                validate=lambda _, x: len(x) > 0,\n118\t            ),\n119\t        ]\n120\t\n121\t        answers = self._prompt(questions)\n122\t        return str(answers[\"custom_model\"]).strip()\n123\t\n124\t    def _get_openai_compatible_model(self) -> dict[str, str]:\n125\t        \"\"\"Prompt for OpenAI-compatible connection details.\"\"\"\n126\t        existing_model = self.config.model\n127\t        existing_is_openai = (\n128\t            existing_model.model_provider == \"openai\"\n129\t            or existing_model.base_url is not None\n130\t            or existing_model.api_key is not None\n131\t        )\n132\t\n133\t        default_base_url = (existing_model.base_url or \"\") if existing_is_openai else \"\"\n134\t        default_model_name = existing_model.name if existing_is_openai else \"\"\n135\t\n136\t        questions = [\n137\t            inquirer.Text(\n138\t                \"base_url\",\n139\t                message=\"Enter the base URL for the OpenAI-compatible API\",\n140\t                default=default_base_url,\n141\t                validate=lambda _, x: len(x.strip() or default_base_url) > 0,\n142\t            ),\n143\t            inquirer.Text(\n144\t                \"model_name\",\n145\t                message=\"Enter the model name\",\n146\t                default=default_model_name,\n147\t                validate=lambda _, x: len(x.strip() or default_model_name) > 0,\n148\t            ),\n149\t        ]\n150\t\n151\t        answers = self._prompt(questions)\n152\t        base_url = str(answers.get(\"base_url\", \"\")).strip() or default_base_url\n153\t        model_name = str(answers.get(\"model_name\", \"\")).strip() or default_model_name\n154\t\n155\t        if not base_url:\n156\t            console.print(\"[red]Base URL cannot be empty. Please try again.[/red]\")\n157\t            return self._get_openai_compatible_model()\n158\t\n159\t        if not model_name:\n160\t            console.print(\"[red]Model name cannot be empty. Please try again.[/red]\")\n161\t            return self._get_openai_compatible_model()\n162\t\n163\t        existing_api_key = existing_model.api_key if existing_is_openai else None\n164\t        api_key: str | None = None\n165\t\n166\t        if existing_api_key:\n167\t            confirm = self._prompt(\n168\t                [\n169\t                    inquirer.Confirm(\n170\t                        \"keep_api_key\",\n171\t                        message=\"Reuse the existing API key?\",\n172\t                        default=True,\n173\t                    )\n174\t                ]\n175\t            )\n176\t            if confirm.get(\"keep_api_key\", True):\n177\t                api_key = existing_api_key\n178\t            else:\n179\t                api_key = self._prompt_for_openai_api_key()\n180\t        else:\n181\t            api_key = self._prompt_for_openai_api_key()\n182\t\n183\t        return {\n184\t            \"base_url\": base_url,\n185\t            \"model_name\": model_name,\n186\t            \"api_key\": api_key,\n187\t        }\n188\t\n189\t    def _prompt_for_openai_api_key(self) -> str:\n190\t        while True:\n191\t            answers = self._prompt(\n192\t                [\n193\t                    inquirer.Password(\n194\t                        \"api_key\",\n195\t                        message=\"Enter the API key\",\n196\t                        validate=lambda _, x: len(x.strip()) > 0,\n197\t                    )\n198\t                ]\n199\t            )\n200\t            api_key = str(answers.get(\"api_key\", \"\")).strip()\n201\t            if api_key:\n202\t                return api_key\n203\t            console.print(\"[red]API key cannot be empty. Please try again.[/red]\")\n204\t\n205\t    def _configure_api_keys(self):\n206\t        \"\"\"Configure API keys based on the selected model.\"\"\"\n207\t        console.print(\"\\n[bold]API Key Configuration[/bold]\")\n208\t\n209\t        if self.config.model.api_key:\n210\t            console.print(\n211\t                \"[green]API key saved for the selected model. No additional configuration needed.[/green]\"\n212\t            )\n213\t            return\n214\t\n215\t        model_name = self.config.model.name\n216\t\n217\t        # Determine which API key we need based on the model prefix\n218\t        api_key_env = None\n219\t\n220\t        provider, separator, _ = model_name.partition(\":\")\n221\t        if separator:\n222\t            api_key_env = self.MODEL_TO_API_KEY_ENV.get(provider)\n223\t\n224\t        if not api_key_env:\n225\t            console.print(\n226\t                \"[yellow]No API key configuration needed for this model.[/yellow]\"\n227\t            )\n228\t            return\n229\t\n230\t        # Check if the API key is already in the environment\n231\t        if os.environ.get(api_key_env):\n232\t            console.print(\n233\t                f\"[green]Found {api_key_env} in environment variables.[/green]\"\n234\t            )\n235\t\n236\t            # Ask if user wants to save to config\n237\t            questions = [\n238\t                inquirer.Confirm(\n239\t                    \"save_api_key\",\n240\t                    message=f\"Do you want to save this {api_key_env} to the VibeGit config?\",\n241\t                    default=True,\n242\t                ),\n243\t            ]\n244\t\n245\t            answers = self._prompt(questions)\n246\t            if answers[\"save_api_key\"]:\n247\t                self.config.api_keys[api_key_env] = os.environ[api_key_env]\n248\t                console.print(f\"[green]{api_key_env} saved to config.[/green]\")\n249\t            else:\n250\t                console.print(\n251\t                    f\"[yellow]{api_key_env} will be used from environment variables.[/yellow]\"\n252\t                )\n253\t\n254\t            return\n255\t\n256\t        # API key not found in environment, prompt for it\n257\t        console.print(\n258\t            f\"[yellow]No {api_key_env} found in environment variables.[/yellow]\"\n259\t        )\n260\t\n261\t        questions = [\n262\t            inquirer.Password(\n263\t                \"api_key\",\n264\t                message=f\"Enter your {api_key_env}\",\n265\t                validate=lambda _, x: len(x) > 0,\n266\t            ),\n267\t        ]\n268\t\n269\t        answers = self._prompt(questions)\n270\t        api_key = str(answers.get(\"api_key\", \"\")).strip()\n271\t\n272\t        if api_key:\n273\t            # Set in both environment and config\n274\t            os.environ[api_key_env] = api_key\n275\t            self.config.api_keys[api_key_env] = api_key\n276\t            console.print(f\"[green]{api_key_env} configured successfully.[/green]\")\n277\t        else:\n278\t            console.print(\n279\t                f\"[red]No {api_key_env} provided. You'll need to set it later.[/red]\"\n280\t            )\n281\t\n282\t    def _save_config(self):\n283\t        \"\"\"Save the configuration to disk.\"\"\"\n284\t        try:\n285\t            self.config.save_config()\n286\t            console.print(f\"[green]Configuration saved to {CONFIG_PATH}[/green]\")\n287\t        except (OSError, TypeError) as e:\n288\t            console.print(f\"[bold red]Error saving configuration: {e}[/bold red]\")\n289\t            sys.exit(1)\n290\t\n291\t\n292\tdef should_run_wizard():\n293\t    \"\"\"Check if the config wizard should run (first time use).\"\"\"\n294\t    return not CONFIG_PATH.exists()\n295\t\n296\t\n297\tdef run_wizard_if_needed():\n298\t    \"\"\"Run the config wizard if no configuration file exists.\"\"\"\n299\t    if should_run_wizard():\n300\t        wizard = ConfigWizard()\n301\t        wizard.run()\n302\t        return True\n303\t    return False\n304\t"}]},"parent_tool_use_id":null,"session_id":"4af49a4b-c14f-41cf-83cf-bdddab83488a","uuid":"30787c53-5737-4f54-87ec-f19a1e4300e8","timestamp":"2026-10-14T16:57:38.993Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sanjithsambath/code/router-migrate-v4/eval/work/heldout2/pristine/vibegit/vibegit/wizard.py","content":"import os\nimport sys\nfrom typing import Any, ClassVar, cast\n\nimport inquirer\nfrom rich.console import Console\n\nfrom vibegit.config import CONFIG_PATH, Config, ModelConfig\n\nconsole = Console()\n\n\nclass ConfigWizard:\n    \"\"\"Interactive configuration wizard for VibeGit.\n\n    Shows up when users start VibeGit for the first time,\n    asking for essential configuration values like the LLM model and API keys.\n    \"\"\"\n\n    CUSTOM_PYDANTIC_AI_OPTION = \"Custom model (<provider>:<model> format, see https://ai.pydantic.dev/api/models/base/)\"\n    CUSTOM_OPENAI_OPTION = \"Custom model (OpenAI API compatible)\"\n\n    # Model presets with friendly names and their Pydantic AI provider:model format\n    MODEL_PRESETS: ClassVar[dict[str, str]] = {\n        \"Gemini 3.7 Flash (Recommended)\": \"google:gemini-3.8-flash\",\n        \"Gemini 3.5 Flash-Lite (Fast and cost-efficient)\": \"google:gemini-3.5-flash-lite\",\n        \"Gemini 3.1 Pro (Preview)\": \"google:gemini-3.1-pro-preview\",\n        \"GPT-5.6 Terra (Balanced)\": \"openai:gpt-5.6-terra\",\n        \"GPT-5.6 Sol (Highest quality)\": \"openai:gpt-5.6-sol\",\n        \"GPT-5.6 Luna (High volume)\": \"openai:gpt-5.6-luna\",\n        CUSTOM_OPENAI_OPTION: \"custom_openai\",\n        CUSTOM_PYDANTIC_AI_OPTION: \"custom\",\n    }\n\n    # Map model name prefixes to their API key environment variables\n    MODEL_TO_API_KEY_ENV: ClassVar[dict[str, str]] = {\n        \"google\": \"GOOGLE_API_KEY\",\n        \"google-gla\": \"GOOGLE_API_KEY\",\n        \"google_genai\": \"GOOGLE_API_KEY\",\n        \"openai\": \"OPENAI_API_KEY\",\n        \"grok\": \"GROK_API_KEY\",\n        \"xai\": \"GROK_API_KEY\",\n    }\n\n    def __init__(self):\n        self.config = Config()\n\n    @staticmethod\n    def _prompt(questions: list[Any]) -> dict[str, Any]:\n        answers = inquirer.prompt(questions)\n        if answers is None:\n            raise KeyboardInterrupt\n        return cast(dict[str, Any], answers)\n\n    def run(self):\n        \"\"\"Run the interactive configuration wizard.\"\"\"\n        console.print(\"[bold blue]VibeGit Configuration Wizard[/bold blue]\")\n        console.print(\"Let's set up VibeGit for first use.\\n\")\n\n        try:\n            self._configure_model()\n            self._configure_api_keys()\n            self._save_config()\n        except KeyboardInterrupt:\n            console.print(\"\\n[yellow]Configuration cancelled.[/yellow]\")\n            raise SystemExit(130) from None\n\n        console.print(\n            \"\\n[bold green]Configuration complete! VibeGit is ready to use.[/bold green]\"\n        )\n\n    def _configure_model(self):\n        \"\"\"Configure the LLM model to use.\"\"\"\n        console.print(\"[bold]LLM Model Configuration[/bold]\")\n        console.print(\"Choose which AI model to use for generating commit proposals:\")\n\n        # Create choices for the model selection\n        model_choices = list(self.MODEL_PRESETS.keys())\n\n        questions = [\n            inquirer.List(\n                \"model_choice\",\n                message=\"Select an LLM model:\",\n                choices=model_choices,\n                default=model_choices[0],\n            ),\n        ]\n\n        answers = self._prompt(questions)\n        model_choice = answers.get(\"model_choice\")\n\n        if not isinstance(model_choice, str) or model_choice not in self.MODEL_PRESETS:\n            raise KeyboardInterrupt\n\n        if model_choice == self.CUSTOM_PYDANTIC_AI_OPTION:\n            custom_model = self._get_custom_model()\n            self.config.model = ModelConfig(name=custom_model)\n        elif model_choice == self.CUSTOM_OPENAI_OPTION:\n            openai_custom = self._get_openai_compatible_model()\n            self.config.model = ModelConfig(\n                name=openai_custom[\"model_name\"],\n                base_url=openai_custom[\"base_url\"],\n                api_key=openai_custom[\"api_key\"],\n                model_provider=\"openai\",\n            )\n        else:\n            self.config.model = ModelConfig(name=self.MODEL_PRESETS[model_choice])\n\n        console.print(f\"[green]Model set to: {self.config.model.name}[/green]\")\n\n    def _get_custom_model(self) -> str:\n        \"\"\"Prompt for a custom model name.\"\"\"\n        questions = [\n            inquirer.Text(\n                \"custom_model\",\n                message=\"Enter the model name in Pydantic AI <provider>:<model> format\",\n                validate=lambda _, x: len(x) > 0,\n            ),\n        ]\n\n        answers = self._prompt(questions)\n        return str(answers[\"custom_model\"]).strip()\n\n    def _get_openai_compatible_model(self) -> dict[str, str]:\n        \"\"\"Prompt for OpenAI-compatible connection details.\"\"\"\n        existing_model = self.config.model\n        existing_is_openai = (\n            existing_model.model_provider == \"openai\"\n            or existing_model.base_url is not None\n            or existing_model.api_key is not None\n        )\n\n        default_base_url = (existing_model.base_url or \"\") if existing_is_openai else \"\"\n        default_model_name = existing_model.name if existing_is_openai else \"\"\n\n        questions = [\n            inquirer.Text(\n                \"base_url\",\n                message=\"Enter the base URL for the OpenAI-compatible API\",\n                default=default_base_url,\n                validate=lambda _, x: len(x.strip() or default_base_url) > 0,\n            ),\n            inquirer.Text(\n                \"model_name\",\n                message=\"Enter the model name\",\n                default=default_model_name,\n                validate=lambda _, x: len(x.strip() or default_model_name) > 0,\n            ),\n        ]\n\n        answers = self._prompt(questions)\n        base_url = str(answers.get(\"base_url\", \"\")).strip() or default_base_url\n        model_name = str(answers.get(\"model_name\", \"\")).strip() or default_model_name\n\n        if not base_url:\n            console.print(\"[red]Base URL cannot be empty. Please try again.[/red]\")\n            return self._get_openai_compatible_model()\n\n        if not model_name:\n            console.print(\"[red]Model name cannot be empty. Please try again.[/red]\")\n            return self._get_openai_compatible_model()\n\n        existing_api_key = existing_model.api_key if existing_is_openai else None\n        api_key: str | None = None\n\n        if existing_api_key:\n            confirm = self._prompt(\n                [\n                    inquirer.Confirm(\n                        \"keep_api_key\",\n                        message=\"Reuse the existing API key?\",\n                        default=True,\n                    )\n                ]\n            )\n            if confirm.get(\"keep_api_key\", True):\n                api_key = existing_api_key\n            else:\n                api_key = self._prompt_for_openai_api_key()\n        else:\n            api_key = self._prompt_for_openai_api_key()\n\n        return {\n            \"base_url\": base_url,\n            \"model_name\": model_name,\n            \"api_key\": api_key,\n        }\n\n    def _prompt_for_openai_api_key(self) -> str:\n        while True:\n            answers = self._prompt(\n                [\n                    inquirer.Password(\n                        \"api_key\",\n                        message=\"Enter the API key\",\n                        validate=lambda _, x: len(x.strip()) > 0,\n                    )\n                ]\n            )\n            api_key = str(answers.get(\"api_key\", \"\")).strip()\n            if api_key:\n                return api_key\n            console.print(\"[red]API key cannot be empty. Please try again.[/red]\")\n\n    def _configure_api_keys(self):\n        \"\"\"Configure API keys based on the selected model.\"\"\"\n        console.print(\"\\n[bold]API Key Configuration[/bold]\")\n\n        if self.config.model.api_key:\n            console.print(\n                \"[green]API key saved for the selected model. No additional configuration needed.[/green]\"\n            )\n            return\n\n        model_name = self.config.model.name\n\n        # Determine which API key we need based on the model prefix\n        api_key_env = None\n\n        provider, separator, _ = model_name.partition(\":\")\n        if separator:\n            api_key_env = self.MODEL_TO_API_KEY_ENV.get(provider)\n\n        if not api_key_env:\n            console.print(\n                \"[yellow]No API key configuration needed for this model.[/yellow]\"\n            )\n            return\n\n        # Check if the API key is already in the environment\n        if os.environ.get(api_key_env):\n            console.print(\n                f\"[green]Found {api_key_env} in environment variables.[/green]\"\n            )\n\n            # Ask if user wants to save to config\n            questions = [\n                inquirer.Confirm(\n                    \"save_api_key\",\n                    message=f\"Do you want to save this {api_key_env} to the VibeGit config?\",\n                    default=True,\n                ),\n            ]\n\n            answers = self._prompt(questions)\n            if answers[\"save_api_key\"]:\n                self.config.api_keys[api_key_env] = os.environ[api_key_env]\n                console.print(f\"[green]{api_key_env} saved to config.[/green]\")\n            else:\n                console.print(\n                    f\"[yellow]{api_key_env} will be used from environment variables.[/yellow]\"\n                )\n\n            return\n\n        # API key not found in environment, prompt for it\n        console.print(\n            f\"[yellow]No {api_key_env} found in environment variables.[/yellow]\"\n        )\n\n        questions = [\n            inquirer.Password(\n                \"api_key\",\n                message=f\"Enter your {api_key_env}\",\n                validate=lambda _, x: len(x) > 0,\n            ),\n        ]\n\n        answers = self._prompt(questions)\n        api_key = str(answers.get(\"api_key\", \"\")).strip()\n\n        if api_key:\n            # Set in both environment and config\n            os.environ[api_key_env] = api_key\n            self.config.api_keys[api_key_env] = api_key\n            console.print(f\"[green]{api_key_env} configured successfully.[/green]\")\n        else:\n            console.print(\n                f\"[red]No {api_key_env} provided. You'll need to set it later.[/red]\"\n            )\n\n    def _save_config(self):\n        \"\"\"Save the configuration to disk.\"\"\"\n        try:\n            self.config.save_config()\n            console.print(f\"[green]Configuration saved to {CONFIG_PATH}[/green]\")\n        except (OSError, TypeError) as e:\n            console.print(f\"[bold red]Error saving configuration: {e}[/bold red]\")\n            sys.exit(1)\n\n\ndef should_run_wizard():\n    \"\"\"Check if the config wizard should run (first time use).\"\"\"\n    return not CONFIG_PATH.exists()\n\n\ndef run_wizard_if_needed():\n    \"\"\"Run the config wizard if no configuration file exists.\"\"\"\n    if should_run_wizard():\n        wizard = ConfigWizard()\n        wizard.run()\n        return True\n    return False\n","numLines":304,"startLine":1,"totalLines":304}}}
