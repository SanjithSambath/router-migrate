# local envs and tools (installed inside this folder only)
.venv/
.tools/
node_modules/
# (also when they are symlinks, as in git worktrees that share the main checkout's envs)
/.venv
/.tools
/node_modules
__pycache__/
*.pyc
.pytest_cache/
.coverage
htmlcov/
# eval working copies (cloned at pinned commits; reproducible via eval/repos.json)
eval/work/
/eval/work
eval/logs/raw/
*.log
.DS_Store
.env
tests/_rendered/
# agent transcripts (bulky; kept on disk, not tracked)
**/transcript.jsonl
**/transcript.jsonl.gz
# repo-local router-migrate state (when the tool is run on this repo or a copy inside it).
# The archived adversarial-review repros keep their recorded state as evidence.
.router-migrate/
!archive/research/review_scratch/codemod_repos/*/.router-migrate/
# packaging artifacts
*.egg-info/
/build/
/dist/
