{
 "name": "drop_params_fold_name_and_clamp_max_tokens",
 "policy": {
  "version": 1,
  "features": {
   "src/app.py:ask": {
    "drop_params": [
     "name",
     "max_tokens"
    ]
   }
  }
 },
 "feature": "src/app.py:ask",
 "request_path": "/v1/chat/completions",
 "request": {
  "model": "gpt-4o-mini",
  "messages": [
   {
    "role": "user",
    "name": "alice",
    "content": "hi"
   }
  ],
  "max_tokens": 5,
  "metadata": {
   "feature": "src/app.py:ask"
  }
 },
 "expect": {
  "router_path": "/v1/responses",
  "body_has": {
   "max_output_tokens": 16
  },
  "body_lacks": [
   "name"
  ],
  "needs_policy": true
 }
}