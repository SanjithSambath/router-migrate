{
 "name": "model_map_swaps_non_catalog_model",
 "policy": {
  "version": 1,
  "defaults": {
   "model_map": {
    "claude-3-5-sonnet-20240620": "claude-sonnet-4-5"
   }
  }
 },
 "feature": "src/app.py:ask",
 "request_path": "/v1/messages",
 "request": {
  "model": "claude-3-5-sonnet-20240620",
  "max_tokens": 32,
  "messages": [
   {
    "role": "user",
    "content": "hi"
   }
  ],
  "metadata": {
   "user_id": "u"
  }
 },
 "expect": {
  "router_path": "/v1/messages",
  "body_has": {
   "model": "claude-sonnet-4-5"
  },
  "body_lacks": [],
  "needs_policy": true
 }
}