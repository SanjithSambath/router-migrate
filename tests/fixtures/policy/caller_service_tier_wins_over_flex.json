{
 "name": "caller_service_tier_wins_over_flex",
 "policy": {
  "version": 1,
  "features": {
   "src/app.py:ask": {
    "allow_flex_tier": true
   }
  }
 },
 "feature": "src/app.py:ask",
 "request_path": "/v1/chat/completions",
 "request": {
  "model": "gpt-4o-mini",
  "messages": [
   {
    "role": "user",
    "content": "hi"
   }
  ],
  "max_tokens": 32,
  "metadata": {
   "feature": "src/app.py:ask"
  },
  "service_tier": "priority"
 },
 "expect": {
  "router_path": "/v1/responses",
  "body_has": {
   "service_tier": "priority"
  },
  "body_lacks": [
   "allow_flex_tier"
  ]
 }
}