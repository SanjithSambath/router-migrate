{
 "name": "flex_guard_skips_non_openai",
 "policy": {
  "version": 1,
  "features": {
   "src/app.py:ask": {
    "allow_flex_tier": true
   }
  }
 },
 "feature": "src/app.py:ask",
 "request_path": "/v1/chat/completions",
 "request": {
  "model": "claude-haiku-4-5",
  "messages": [
   {
    "role": "user",
    "content": "hi"
   }
  ],
  "max_tokens": 32,
  "metadata": {
   "feature": "src/app.py:ask"
  }
 },
 "expect": {
  "router_path": "/v1/responses",
  "body_has": {
   "service_tier": "default"
  },
  "body_lacks": [
   "allow_flex_tier"
  ]
 }
}