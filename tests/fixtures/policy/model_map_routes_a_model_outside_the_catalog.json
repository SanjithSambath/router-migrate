{
 "name": "model_map_routes_a_model_outside_the_catalog",
 "policy": {
  "version": 1,
  "features": {
   "src/app.py:ask": {
    "model_map": {
     "gpt-4-0314": "gpt-4.1"
    }
   }
  }
 },
 "feature": "src/app.py:ask",
 "request_path": "/v1/chat/completions",
 "request": {
  "model": "gpt-4-0314",
  "messages": [
   {
    "role": "user",
    "content": "hi"
   }
  ],
  "max_tokens": 32,
  "metadata": {
   "feature": "src/app.py:ask"
  }
 },
 "expect": {
  "router_path": "/v1/responses",
  "body_has": {
   "model": "gpt-4.1"
  },
  "body_lacks": [
   "service_tier"
  ],
  "needs_policy": true
 }
}