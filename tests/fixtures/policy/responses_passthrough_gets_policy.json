{
 "name": "responses_passthrough_gets_policy",
 "policy": {
  "version": 1,
  "features": {
   "src/app.py:ask": {
    "allow_flex_tier": true,
    "metadata": {
     "team": "r"
    }
   }
  }
 },
 "feature": "src/app.py:ask",
 "request_path": "/v1/responses",
 "request": {
  "model": "gpt-5-nano",
  "input": "hi",
  "metadata": {
   "feature": "src/app.py:ask"
  }
 },
 "expect": {
  "router_path": "/v1/responses",
  "body_has": {
   "allow_flex_tier": true,
   "metadata": {
    "team": "r",
    "feature": "src/app.py:ask"
   }
  },
  "body_lacks": [
   "service_tier"
  ]
 }
}