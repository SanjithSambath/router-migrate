{
 "name": "messages_surface_gets_no_policy",
 "policy": {
  "version": 1,
  "defaults": {
   "metadata": {
    "team": "x"
   },
   "provider_timeout": 30
  }
 },
 "feature": "src/app.py:ask",
 "request_path": "/v1/messages",
 "request": {
  "model": "claude-haiku-4-5",
  "max_tokens": 32,
  "messages": [
   {
    "role": "user",
    "content": "hi"
   }
  ]
 },
 "expect": {
  "router_path": "/v1/messages",
  "body_has": {
   "model": "claude-haiku-4-5"
  },
  "body_lacks": [
   "metadata",
   "provider_timeout",
   "allow_flex_tier",
   "models"
  ]
 }
}