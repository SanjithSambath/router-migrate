{
 "name": "fallback_guard_temperature",
 "policy": {
  "version": 1,
  "features": {
   "src/app.py:ask": {
    "fallbacks": [
     "gpt-5-nano",
     "gpt-4.1-mini"
    ]
   }
  }
 },
 "feature": "src/app.py:ask",
 "request_path": "/v1/chat/completions",
 "request": {
  "model": "gpt-4o-mini",
  "messages": [
   {
    "role": "user",
    "content": "hi"
   }
  ],
  "max_tokens": 32,
  "metadata": {
   "feature": "src/app.py:ask"
  },
  "temperature": 0.2
 },
 "expect": {
  "router_path": "/v1/responses",
  "body_has": {
   "models": [
    "gpt-4o-mini",
    "gpt-4.1-mini"
   ]
  },
  "body_lacks": [
   "model"
  ]
 }
}