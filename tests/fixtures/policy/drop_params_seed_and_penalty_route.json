{
 "name": "drop_params_seed_and_penalty_route",
 "policy": {
  "version": 1,
  "features": {
   "src/app.py:ask": {
    "drop_params": [
     "seed",
     "presence_penalty"
    ]
   }
  }
 },
 "feature": "src/app.py:ask",
 "request_path": "/v1/chat/completions",
 "request": {
  "model": "gpt-4o-mini",
  "messages": [
   {
    "role": "user",
    "content": "hi"
   }
  ],
  "seed": 0,
  "presence_penalty": 0.5,
  "max_tokens": 32,
  "metadata": {
   "feature": "src/app.py:ask"
  }
 },
 "expect": {
  "router_path": "/v1/responses",
  "body_has": {
   "max_output_tokens": 32
  },
  "body_lacks": [
   "seed",
   "presence_penalty"
  ],
  "needs_policy": true
 }
}