{
 "name": "model_map_swaps_the_model_for_one_feature",
 "policy": {
  "version": 1,
  "features": {
   "src/app.py:ask": {
    "model_map": {
     "gpt-4o-mini": "gpt-4.1-mini"
    }
   }
  }
 },
 "feature": "src/app.py:ask",
 "request_path": "/v1/chat/completions",
 "request": {
  "model": "gpt-4o-mini",
  "messages": [
   {
    "role": "user",
    "content": "hi"
   }
  ],
  "max_tokens": 32,
  "metadata": {
   "feature": "src/app.py:ask"
  }
 },
 "expect": {
  "router_path": "/v1/responses",
  "body_has": {
   "model": "gpt-4.1-mini"
  },
  "body_lacks": [
   "service_tier",
   "models"
  ]
 }
}