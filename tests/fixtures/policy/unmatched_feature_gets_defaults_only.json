{
 "name": "unmatched_feature_gets_defaults_only",
 "policy": {
  "version": 1,
  "defaults": {
   "metadata": {
    "team": "x"
   }
  },
  "features": {
   "other.py:f": {
    "allow_flex_tier": true
   }
  }
 },
 "feature": "src/app.py:ask",
 "request_path": "/v1/chat/completions",
 "request": {
  "model": "gpt-4o-mini",
  "messages": [
   {
    "role": "user",
    "content": "hi"
   }
  ],
  "max_tokens": 32,
  "metadata": {
   "feature": "src/app.py:ask"
  }
 },
 "expect": {
  "router_path": "/v1/responses",
  "body_has": {
   "metadata": {
    "team": "x"
   }
  },
  "body_lacks": [
   "allow_flex_tier",
   "service_tier"
  ]
 }
}