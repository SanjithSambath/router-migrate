{
 "name": "fallbacks_become_models_list",
 "policy": {
  "version": 1,
  "features": {
   "src/app.py:ask": {
    "fallbacks": [
     "gpt-4.1-mini",
     "claude-haiku-4-5"
    ],
    "allow_flex_tier": true
   }
  }
 },
 "feature": "src/app.py:ask",
 "request_path": "/v1/chat/completions",
 "request": {
  "model": "gpt-4o-mini",
  "messages": [
   {
    "role": "user",
    "content": "hi"
   }
  ],
  "max_tokens": 32,
  "metadata": {
   "feature": "src/app.py:ask"
  }
 },
 "expect": {
  "router_path": "/v1/responses",
  "body_has": {
   "models": [
    "gpt-4o-mini",
    "gpt-4.1-mini",
    "claude-haiku-4-5"
   ]
  },
  "body_lacks": [
   "model",
   "allow_flex_tier"
  ]
 }
}