@@ -0,0 +1,28 @@
+"""Router configuration: one OpenAI Responses-compatible endpoint in front of all providers.
+
+Router holds the provider credentials, so the only secret the application needs is
+RAMP_ROUTER_API_KEY. Model IDs are account-specific and must come from Router's
+`GET /v1/models`; they are read from the environment rather than hardcoded.
+"""
+
+import os
+
+from openai import OpenAI
+
+ROUTER_BASE_URL = "https://api.router.com/v1"
+ROUTER_API_KEY_ENV = "RAMP_ROUTER_API_KEY"
+ROUTER_MODEL_ENV = "ROUTER_MODEL"
+
+
+def router_client(**kwargs) -> OpenAI:
+    """Return an OpenAI SDK client pointed at Router, authenticated with RAMP_ROUTER_API_KEY."""
+    api_key = os.environ.get(ROUTER_API_KEY_ENV)
+    if not api_key:
+        # Fail loudly instead of letting the SDK fall back to a provider key (OPENAI_API_KEY).
+        raise RuntimeError(f"{ROUTER_API_KEY_ENV} is not set.")
+    return OpenAI(base_url=ROUTER_BASE_URL, api_key=api_key, **kwargs)
+
+
+def default_model():
+    """Default Router model ID (from GET /v1/models), read from ROUTER_MODEL."""
+    return os.environ.get(ROUTER_MODEL_ENV) or None
