+import os
+from types import SimpleNamespace
+
+from openai import OpenAI
+
+# Router: one OpenAI Responses-compatible API in front of all providers.
+ROUTER_BASE_URL = "https://api.router.com/v1"
+ROUTER_API_KEY_ENV = "RAMP_ROUTER_API_KEY"
+ROUTER_MODEL_ENV = "ROUTER_MODEL"
+
+
+def get_router_client():
+    """OpenAI SDK client pointed at Router. Router holds the provider credentials."""
+    api_key = os.environ.get(ROUTER_API_KEY_ENV)
+    if not api_key:
+        # Fail loudly instead of letting the SDK fall back to a provider key (OPENAI_API_KEY).
+        raise RuntimeError(f"{ROUTER_API_KEY_ENV} is not set.")
+    return OpenAI(base_url=ROUTER_BASE_URL, api_key=api_key)
+
+
+def get_router_model(env_var=ROUTER_MODEL_ENV):
+    """Router model ID (from GET /v1/models) read from env_var, falling back to ROUTER_MODEL."""
+    model = os.environ.get(env_var) or os.environ.get(ROUTER_MODEL_ENV)
+    if not model:
+        raise ValueError(f"Set {env_var} (or {ROUTER_MODEL_ENV}) to a Router model ID.")
+    return model
+
+
+def _to_responses_tool(tool):
+    """Chat Completions function tool -> Responses function tool (same definition)."""
+    if tool.get("type") == "function" and "function" in tool:
+        fn = tool["function"]
+        return {
+            "type": "function",
+            "name": fn["name"],
+            "description": fn.get("description", ""),
+            "parameters": fn.get("parameters", {"type": "object", "properties": {}}),
+            # Chat Completions defaults to non-strict schemas; Responses defaults to strict.
+            "strict": fn.get("strict", False),
+        }
+    return tool
+
+
+def _response_to_message(response):
+    """Responses output -> message-like object exposing .role, .content and .tool_calls."""
+    text_parts, tool_calls = [], []
+    for item in response.output:
+        if item.type == "message":
+            for part in item.content:
+                if part.type == "output_text":
+                    text_parts.append(part.text)
+        elif item.type == "function_call":
+            tool_calls.append(
+                SimpleNamespace(
+                    id=item.call_id,
+                    type="function",
+                    function=SimpleNamespace(name=item.name, arguments=item.arguments),
+                )
+            )
+    return SimpleNamespace(
+        role="assistant",
+        content="".join(text_parts) if text_parts else None,
+        tool_calls=tool_calls or None,
+    )
+
+
