+# --- Responses API transport helpers -------------------------------------------------
+# Swarm's public message format (Response.messages, history passed to run()) stays
+# chat-style. These helpers translate it to/from the OpenAI Responses schema that
+# Router speaks, so only the transport changes.
+
+
+def _to_responses_tools(tools: List[dict]) -> List[dict]:
+    """Chat Completions function tool -> Responses function tool (same name/description/schema)."""
+    converted = []
+    for tool in tools:
+        if tool.get("type") == "function" and "function" in tool:
+            fn = tool["function"]
+            converted.append(
+                {
+                    "type": "function",
+                    "name": fn["name"],
+                    "description": fn.get("description", ""),
+                    "parameters": fn["parameters"],
+                    # Chat Completions defaults to non-strict schemas; Responses defaults to strict.
+                    "strict": fn.get("strict", False),
+                }
+            )
+        else:
+            converted.append(tool)
+    return converted
+
+
+def _to_responses_tool_choice(tool_choice):
+    if (
+        isinstance(tool_choice, dict)
+        and tool_choice.get("type") == "function"
+        and "function" in tool_choice
+    ):
+        return {"type": "function", "name": tool_choice["function"]["name"]}
+    return tool_choice
+
+
+def _text_content(content, role: str):
+    """Convert chat message content to Responses content. Only text is supported."""
+    if not isinstance(content, list):
+        return content
+    if role == "assistant":
+        texts = []
+        for part in content:
+            if isinstance(part, dict) and part.get("type") == "text":
+                texts.append(part["text"])
+            else:
+                raise ValueError(
+                    f"Unsupported assistant content part for Router migration: {part!r}"
+                )
+        return "".join(texts)
+    parts = []
+    for part in content:
+        if isinstance(part, dict) and part.get("type") == "text":
+            parts.append({"type": "input_text", "text": part["text"]})
+        else:
+            # Image/audio/file parts need a Router model confirmed to support that modality.
+            raise ValueError(
+                f"Unsupported content part for Router migration (text only): {part!r}"
+            )
+    return parts
+
+
+def _to_responses_input(history: List[dict]) -> List[dict]:
+    """Chat-style history -> Responses input items."""
+    items = []
+    for message in history:
+        role = message.get("role")
+        if role == "tool":
+            items.append(
+                {
+                    "type": "function_call_output",
+                    "call_id": message["tool_call_id"],
+                    "output": message.get("content") or "",
+                }
+            )
+            continue
+        content = message.get("content")
+        if role == "assistant":
+            if content:
+                items.append(
+                    {"role": "assistant", "content": _text_content(content, role)}
+                )
+            for tool_call in message.get("tool_calls") or []:
+                items.append(
+                    {
+                        "type": "function_call",
+                        "call_id": tool_call["id"],
+                        "name": tool_call["function"]["name"],
+                        "arguments": tool_call["function"]["arguments"],
+                    }
+                )
+            continue
+        items.append({"role": role, "content": _text_content(content, role)})
+    return items
+
+
+def _response_to_message(response) -> dict:
+    """Responses output -> chat-style assistant message dict (as previously stored in history)."""
+    text_parts, refusal_parts, tool_calls = [], [], []
+    for item in response.output:
+        if item.type == "message":
+            for part in item.content:
+                if part.type == "output_text":
+                    text_parts.append(part.text)
+                elif part.type == "refusal":
+                    refusal_parts.append(part.refusal)
+        elif item.type == "function_call":
+            tool_calls.append(
+                {
+                    "id": item.call_id,
+                    "type": "function",
+                    "function": {"name": item.name, "arguments": item.arguments},
+                }
+            )
+        # Other item types (e.g. reasoning) have no chat-message equivalent.
+    return {
+        "content": "".join(text_parts) if text_parts else None,
+        "refusal": "".join(refusal_parts) if refusal_parts else None,
+        "role": "assistant",
+        "function_call": None,
+        "tool_calls": tool_calls or None,
+    }
+
+
+def _empty_delta() -> dict:
+    return {
+        "content": None,
+        "function_call": None,
+        "refusal": None,
+        "role": None,
+        "tool_calls": None,
+    }
+
+
+def _stream_event_to_delta(event):
+    """Responses SSE event -> chat-style streaming delta (None for events with no delta)."""
+    event_type = getattr(event, "type", None)
+    if event_type == "response.created":
+        delta = _empty_delta()
+        delta["role"] = "assistant"
+        return delta
+    if event_type == "response.output_text.delta":
+        delta = _empty_delta()
+        delta["content"] = event.delta
+        return delta
+    if event_type == "response.refusal.delta":
+        delta = _empty_delta()
+        delta["refusal"] = event.delta
+        return delta
+    if event_type == "response.output_item.added" and event.item.type == "function_call":
+        delta = _empty_delta()
+        delta["tool_calls"] = [
+            {
+                "index": event.output_index,
+                "id": event.item.call_id,
+                "type": "function",
+                "function": {"name": event.item.name, "arguments": ""},
+            }
+        ]
+        return delta
+    if event_type == "response.function_call_arguments.delta":
+        delta = _empty_delta()
+        delta["tool_calls"] = [
+            {
+                "index": event.output_index,
+                "id": None,
+                "type": None,
+                "function": {"name": None, "arguments": event.delta},
+            }
+        ]
+        return delta
+    if event_type in ("response.failed", "error"):
+        raise RuntimeError(f"Router streaming error: {event}")
+    return None
+
+
+def _to_tool_call_objects(tool_calls: List[dict]) -> List[ChatCompletionMessageToolCall]:
+    return [
+        ChatCompletionMessageToolCall(
+            id=tool_call["id"],
+            function=Function(
+                arguments=tool_call["function"]["arguments"],
+                name=tool_call["function"]["name"],
+            ),
+            type=tool_call["type"],
+        )
+        for tool_call in tool_calls
+    ]
+
+
