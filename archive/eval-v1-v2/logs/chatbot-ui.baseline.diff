diff --git a/lib/router/responses.ts b/lib/router/responses.ts
new file mode 100644
index 0000000..16977c3
--- /dev/null
+++ b/lib/router/responses.ts
@@ -0,0 +1,314 @@
+// Helpers for calling Router's OpenAI Responses API (POST /v1/responses).
+//
+// The installed `openai` SDK (v4.24) predates `client.responses`, so requests
+// go through the SDK's generic `client.post()` escape hatch. That keeps the
+// SDK's auth, base URL, error types and retry policy. Streaming responses are
+// read via `.asResponse()` because this SDK version's SSE reader drops named
+// events, which is how Responses streams are delivered.
+
+import OpenAI from "openai"
+
+export type ResponsesInputItem = Record<string, any>
+
+export type ResponsesRequestBody = {
+  model: string
+  input: ResponsesInputItem[]
+  instructions?: string
+  temperature?: number
+  max_output_tokens?: number
+  tools?: Record<string, any>[]
+  metadata?: Record<string, string>
+}
+
+const textOf = (content: any): string => {
+  if (typeof content === "string") {
+    return content
+  }
+
+  if (Array.isArray(content)) {
+    return content
+      .map((part: any) =>
+        typeof part === "string"
+          ? part
+          : part?.type === "text"
+            ? part.text ?? ""
+            : ""
+      )
+      .join("")
+  }
+
+  return ""
+}
+
+// Chat Completions `messages` -> Responses `instructions` + `input`.
+// System messages become `instructions`; text/image content parts become
+// input_text / input_image parts. Message text is passed through unchanged.
+export function chatMessagesToResponsesInput(messages: any[]): {
+  instructions?: string
+  input: ResponsesInputItem[]
+} {
+  const systemTexts: string[] = []
+  const input: ResponsesInputItem[] = []
+
+  for (const message of messages) {
+    if (message?.role === "system") {
+      systemTexts.push(textOf(message.content))
+      continue
+    }
+
+    const role = message?.role === "assistant" ? "assistant" : "user"
+    const content = message?.content
+
+    if (!Array.isArray(content)) {
+      input.push({ role, content: content ?? "" })
+      continue
+    }
+
+    input.push({
+      role,
+      content: content.map((part: any) => {
+        if (typeof part === "string") {
+          return {
+            type: role === "assistant" ? "output_text" : "input_text",
+            text: part
+          }
+        }
+
+        if (part?.type === "text") {
+          return {
+            type: role === "assistant" ? "output_text" : "input_text",
+            text: part.text
+          }
+        }
+
+        if (part?.type === "image_url") {
+          return {
+            type: "input_image",
+            image_url: part.image_url?.url,
+            detail: part.image_url?.detail ?? "auto"
+          }
+        }
+
+        return part
+      })
+    })
+  }
+
+  return {
+    instructions: systemTexts.length > 0 ? systemTexts.join("\n\n") : undefined,
+    input
+  }
+}
+
+// Gemini `contents` (role user/model, parts with text/inlineData) ->
+// Responses `input`. Used by the Google route, whose client-side prompt
+// formatting is left unchanged.
+export function geminiContentsToResponsesInput(
+  contents: any[]
+): ResponsesInputItem[] {
+  const flattenParts = (parts: any): any[] =>
+    Array.isArray(parts) ? parts.flatMap(flattenParts) : [parts]
+
+  return contents.map(message => {
+    const role = message?.role === "model" ? "assistant" : "user"
+    const parts = flattenParts(message?.parts ?? []).filter(
+      part => part !== undefined && part !== null
+    )
+
+    return {
+      role,
+      content: parts.map(part => {
+        if (typeof part === "string") {
+          return {
+            type: role === "assistant" ? "output_text" : "input_text",
+            text: part
+          }
+        }
+
+        if (part?.inlineData) {
+          return {
+            type: "input_image",
+            image_url: `data:${part.inlineData.mimeType};base64,${part.inlineData.data}`,
+            detail: "auto"
+          }
+        }
+
+        return {
+          type: role === "assistant" ? "output_text" : "input_text",
+          text: part?.text ?? ""
+        }
+      })
+    }
+  })
+}
+
+export function hasImageInput(input: ResponsesInputItem[]): boolean {
+  return input.some(
+    item =>
+      Array.isArray(item?.content) &&
+      item.content.some((part: any) => part?.type === "input_image")
+  )
+}
+
+// Chat Completions function tool -> Responses function tool. Definitions are
+// unchanged; `strict: false` keeps Chat Completions' non-strict default.
+export function chatToolToResponsesTool(tool: any): Record<string, any> {
+  if (tool?.type === "function" && tool.function) {
+    return {
+      type: "function",
+      name: tool.function.name,
+      description: tool.function.description,
+      parameters: tool.function.parameters,
+      strict: false
+    }
+  }
+
+  return tool
+}
+
+const withoutUndefined = (body: Record<string, any>) =>
+  Object.fromEntries(
+    Object.entries(body).filter(
+      ([, value]) => value !== undefined && value !== null
+    )
+  )
+
+// Non-streaming POST /v1/responses.
+export async function createRouterResponse(
+  client: OpenAI,
+  body: ResponsesRequestBody
+): Promise<any> {
+  return client.post("/responses", { body: withoutUndefined(body) })
+}
+
+// Concatenated text of all `output_text` parts in `response.output`.
+export function getOutputText(response: any): string {
+  if (typeof response?.output_text === "string") {
+    return response.output_text
+  }
+
+  const output: any[] = Array.isArray(response?.output) ? response.output : []
+
+  return output
+    .filter(item => item?.type === "message" && Array.isArray(item.content))
+    .flatMap(item => item.content)
+    .filter((part: any) => part?.type === "output_text")
+    .map((part: any) => part.text ?? "")
+    .join("")
+}
+
+// Streaming POST /v1/responses. Returns a plain-text stream of the output text
+// deltas, matching what the routes previously returned via OpenAIStream().
+export async function streamRouterResponseText(
+  client: OpenAI,
+  body: ResponsesRequestBody
+): Promise<ReadableStream<Uint8Array>> {
+  const response = await client
+    .post("/responses", {
+      body: { ...withoutUndefined(body), stream: true },
+      headers: { Accept: "text/event-stream" }
+    })
+    .asResponse()
+
+  if (!response.body) {
+    throw new Error("Router returned an empty response stream")
+  }
+
+  return responsesEventStreamToText(response.body)
+}
+
+// Converts a Responses SSE stream into a stream of output text.
+export function responsesEventStreamToText(
+  body: ReadableStream<Uint8Array>
+): ReadableStream<Uint8Array> {
+  const reader = body.getReader()
+  const decoder = new TextDecoder()
+  const encoder = new TextEncoder()
+  let buffer = ""
+
+  // Returns the text to emit for one SSE event block (or "" for none).
+  const handleEvent = (rawEvent: string): string => {
+    const data = rawEvent
+      .split(/\r?\n/)
+      .filter(line => line.startsWith("data:"))
+      .map(line => line.slice(5).replace(/^ /, ""))
+      .join("\n")
+
+    if (!data || data === "[DONE]") {
+      return ""
+    }
+
+    let event: any
+    try {
+      event = JSON.parse(data)
+    } catch {
+      return ""
+    }
+
+    switch (event?.type) {
+      case "response.output_text.delta":
+        return typeof event.delta === "string" ? event.delta : ""
+      case "response.failed":
+        throw new Error(
+          event.response?.error?.message || "Router response failed"
+        )
+      case "error":
+        throw new Error(
+          event.message || event.error?.message || "Router stream error"
+        )
+      default:
+        return ""
+    }
+  }
+
+  const drain = (): string => {
+    let text = ""
+    let match: RegExpExecArray | null
+
+    while ((match = /\r?\n\r?\n/.exec(buffer)) !== null) {
+      const rawEvent = buffer.slice(0, match.index)
+      buffer = buffer.slice(match.index + match[0].length)
+      text += handleEvent(rawEvent)
+    }
+
+    return text
+  }
+
+  return new ReadableStream<Uint8Array>({
+    async pull(controller) {
+      try {
+        while (true) {
+          const { done, value } = await reader.read()
+
+          if (done) {
+            buffer += decoder.decode()
+            let text = drain()
+            if (buffer.trim()) {
+              text += handleEvent(buffer)
+              buffer = ""
+            }
+            if (text) {
+              controller.enqueue(encoder.encode(text))
+            }
+            controller.close()
+            return
+          }
+
+          buffer += decoder.decode(value, { stream: true })
+          const text = drain()
+
+          if (text) {
+            controller.enqueue(encoder.encode(text))
+            return
+          }
+        }
+      } catch (error) {
+        controller.error(error)
+        reader.cancel().catch(() => {})
+      }
+    },
+    cancel(reason) {
+      return reader.cancel(reason)
+    }
+  })
+}
diff --git a/lib/router/router-client.ts b/lib/router/router-client.ts
new file mode 100644
index 0000000..47a9843
--- /dev/null
+++ b/lib/router/router-client.ts
@@ -0,0 +1,150 @@
+// Server-only helpers for talking to Ramp's Router
+// (an OpenAI Responses-compatible gateway in front of multiple providers).
+//
+// Configuration (all read from the server environment):
+//   RAMP_ROUTER_API_KEY            - required. Sent as `Authorization: Bearer ...`.
+//   RAMP_ROUTER_BASE_URL           - optional. Defaults to https://api.router.com/v1
+//   RAMP_ROUTER_MODEL_MAP          - JSON object mapping the app's model IDs (the
+//                                    `chatSettings.model` values chosen in the UI)
+//                                    to Router model IDs returned by GET /v1/models.
+//   RAMP_ROUTER_COMMAND_MODEL      - Router model ID used by /api/command.
+//   RAMP_ROUTER_IMAGE_INPUT_MODELS - comma-separated Router model IDs that have been
+//                                    confirmed (via GET /v1/models) to accept image
+//                                    input. Requests that carry images are rejected
+//                                    for any other model.
+//
+// Router holds all provider credentials; this app never sends provider API keys.
+
+import OpenAI from "openai"
+
+export const RAMP_ROUTER_DEFAULT_BASE_URL = "https://api.router.com/v1"
+
+export class RouterConfigError extends Error {
+  status = 400
+
+  constructor(message: string) {
+    super(message)
+    this.name = "RouterConfigError"
+  }
+}
+
+export function isRouterConfigured(): boolean {
+  return Boolean(process.env.RAMP_ROUTER_API_KEY)
+}
+
+export function getRouterApiKey(): string {
+  const apiKey = process.env.RAMP_ROUTER_API_KEY
+
+  if (!apiKey) {
+    const error = new Error(
+      "RAMP_ROUTER_API_KEY is not set on the server. Configure it to enable chat."
+    ) as Error & { status?: number }
+    error.status = 500
+    throw error
+  }
+
+  return apiKey
+}
+
+export function getRouterBaseURL(): string {
+  return (
+    process.env.RAMP_ROUTER_BASE_URL || RAMP_ROUTER_DEFAULT_BASE_URL
+  ).replace(/\/+$/, "")
+}
+
+// Router's Anthropic Messages compatibility surface lives at /v1/messages.
+// The Anthropic SDK appends `/v1/messages` itself, so strip the `/v1` suffix.
+export function getRouterAnthropicBaseURL(): string {
+  return getRouterBaseURL().replace(/\/v1$/, "")
+}
+
+// OpenAI SDK client pointed at Router. `organization: null` stops the SDK from
+// picking up OPENAI_ORG_ID from the environment and forwarding it to Router.
+export function createRouterClient(options: { maxRetries?: number } = {}) {
+  return new OpenAI({
+    apiKey: getRouterApiKey(),
+    baseURL: getRouterBaseURL(),
+    organization: null,
+    ...(options.maxRetries !== undefined
+      ? { maxRetries: options.maxRetries }
+      : {})
+  })
+}
+
+export function getRouterModelMap(): Record<string, string> {
+  const raw = process.env.RAMP_ROUTER_MODEL_MAP
+
+  if (!raw) {
+    return {}
+  }
+
+  try {
+    const parsed = JSON.parse(raw)
+
+    if (!parsed || typeof parsed !== "object" || Array.isArray(parsed)) {
+      console.error("RAMP_ROUTER_MODEL_MAP must be a JSON object")
+      return {}
+    }
+
+    return Object.fromEntries(
+      Object.entries(parsed).filter(
+        ([, value]) => typeof value === "string" && value.length > 0
+      )
+    ) as Record<string, string>
+  } catch (error) {
+    console.error("RAMP_ROUTER_MODEL_MAP is not valid JSON")
+    return {}
+  }
+}
+
+// App model IDs that have a Router model configured (used to decide which
+// models the UI offers).
+export function getRouterMappedAppModelIds(): string[] {
+  return Object.keys(getRouterModelMap())
+}
+
+// Resolve the app's model ID to the account-specific Router model ID.
+// Never falls back to a provider's public model name.
+export function resolveRouterModel(appModelId: string): string {
+  const routerModel = getRouterModelMap()[appModelId]
+
+  if (!routerModel) {
+    throw new RouterConfigError(
+      `Model "${appModelId}" is not configured for Router. Add it to RAMP_ROUTER_MODEL_MAP using a model ID from GET /v1/models.`
+    )
+  }
+
+  return routerModel
+}
+
+export function getRouterCommandModel(): string {
+  const routerModel = process.env.RAMP_ROUTER_COMMAND_MODEL
+
+  if (!routerModel) {
+    throw new RouterConfigError(
+      "RAMP_ROUTER_COMMAND_MODEL is not set. Use a model ID from GET /v1/models."
+    )
+  }
+
+  return routerModel
+}
+
+function getImageInputModels(): string[] {
+  return (process.env.RAMP_ROUTER_IMAGE_INPUT_MODELS || "")
+    .split(",")
+    .map(model => model.trim())
+    .filter(Boolean)
+}
+
+// Image input is only forwarded to Router models that were explicitly
+// confirmed to support it.
+export function assertImageInputSupported(
+  routerModel: string,
+  hasImageInput: boolean
+) {
+  if (hasImageInput && !getImageInputModels().includes(routerModel)) {
+    throw new RouterConfigError(
+      `Router model "${routerModel}" is not confirmed to accept image input. Confirm support via GET /v1/models and add it to RAMP_ROUTER_IMAGE_INPUT_MODELS.`
+    )
+  }
+}
