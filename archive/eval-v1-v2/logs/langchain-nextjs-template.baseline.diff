+// Responses API messages carry content as an array of content blocks, which
+// the tool-calling agent passes through as its final output. Render the text.
+function outputToText(output: unknown): string {
+  if (typeof output === "string") return output;
+  if (Array.isArray(output)) {
+    return output
+      .map((block) =>
+        typeof block === "string"
+          ? block
+          : block?.type === "text" && typeof block.text === "string"
+            ? block.text
+            : "",
+      )
+      .join("");
+  }
+  return "";
+}
+
