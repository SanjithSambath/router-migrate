diff --git a/utils/router.ts b/utils/router.ts
new file mode 100644
index 0000000..7580e7d
--- /dev/null
+++ b/utils/router.ts
@@ -0,0 +1,53 @@
+import { ChatOpenAI, type ChatOpenAIFields } from "@langchain/openai";
+
+/**
+ * Router: an OpenAI Responses-compatible gateway in front of models from
+ * multiple providers. Router holds the provider credentials, so this app only
+ * ever sends RAMP_ROUTER_API_KEY.
+ */
+export const ROUTER_BASE_URL = "https://api.router.com/v1";
+
+/**
+ * Model IDs are account-specific and must come from `GET /v1/models` on
+ * Router. Configure the one to use via the ROUTER_MODEL env var.
+ */
+export function getRouterModel(): string {
+  const model = process.env.ROUTER_MODEL;
+  if (!model) {
+    throw new Error(
+      "ROUTER_MODEL is not set. Set it to a model ID returned by GET https://api.router.com/v1/models.",
+    );
+  }
+  return model;
+}
+
+function getRouterApiKey(): string {
+  const apiKey = process.env.RAMP_ROUTER_API_KEY;
+  if (!apiKey) {
+    // Fail loudly rather than letting the client fall back to a provider key
+    // (e.g. OPENAI_API_KEY) from the environment.
+    throw new Error("RAMP_ROUTER_API_KEY is not set.");
+  }
+  return apiKey;
+}
+
+type RouterChatModelFields = Omit<
+  ChatOpenAIFields,
+  "model" | "modelName" | "apiKey" | "configuration" | "useResponsesApi"
+>;
+
+/**
+ * Creates a LangChain chat model that talks to Router's `POST /v1/responses`
+ * endpoint using the OpenAI Responses API.
+ */
+export function createRouterChatModel(fields: RouterChatModelFields = {}) {
+  return new ChatOpenAI({
+    ...fields,
+    model: getRouterModel(),
+    apiKey: getRouterApiKey(),
+    useResponsesApi: true,
+    configuration: {
+      baseURL: ROUTER_BASE_URL,
+    },
+  });
+}
