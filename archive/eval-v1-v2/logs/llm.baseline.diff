+def router_model_ids() -> list[str]:
+    """Router model IDs configured via environment variables, in order and
+    de-duplicated. The default model (``LLM_ROUTER_DEFAULT_MODEL``) is
+    always included so it resolves without being listed twice."""
+    candidates = [
+        os.environ.get(llm.DEFAULT_MODEL_ENV_VAR) or "",
+        *(os.environ.get(ROUTER_MODELS_ENV_VAR) or "").split(","),
+    ]
+    model_ids: list[str] = []
+    for candidate in candidates:
+        candidate = candidate.strip()
+        if candidate and candidate not in model_ids:
+            model_ids.append(candidate)
+    return model_ids
+
