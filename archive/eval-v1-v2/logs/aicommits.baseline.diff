--- /dev/null
+++ b/src/feature/providers/router.ts
@@ -0,0 +1,45 @@
+import type { JSONValue } from 'ai';
+import type { ProviderDef } from './base.js';
+
+export const ROUTER_DEFAULT_BASE_URL = 'https://api.router.com/v1';
+export const ROUTER_API_KEY_ENV = 'RAMP_ROUTER_API_KEY';
+export const ROUTER_MODEL_ENV = 'ROUTER_MODEL';
+export const ROUTER_FALLBACK_MODEL_ENV = 'ROUTER_FALLBACK_MODEL';
+
+const readEnv = (name: string) => process.env[name]?.trim() || undefined;
+
+export const getRouterApiKey = () => readEnv(ROUTER_API_KEY_ENV);
+
+// Router model IDs are account-specific (see `GET /v1/models`), so they are
+// only ever read from configuration, never hardcoded.
+export const getRouterModel = () => readEnv(ROUTER_MODEL_ENV);
+
+// Router-only request settings travel in the Responses body. `store: false`
+// keeps every request self-contained (the previous Chat Completions transport
+// was stateless), and `metadata` labels spend by feature.
+export const getRouterProviderOptions = (
+	feature: string
+): Record<string, Record<string, JSONValue>> => ({
+	openai: {
+		store: false,
+		metadata: { app: 'aicommits', feature },
+	},
+});
+
+export const RouterProvider: ProviderDef = {
+	name: 'router',
+	displayName: 'Router',
+	// ROUTER_BASE_URL is an optional override (for example, a local mock in tests).
+	baseUrl: readEnv('ROUTER_BASE_URL') || ROUTER_DEFAULT_BASE_URL,
+	defaultModels: [],
+	fallbackModel: readEnv(ROUTER_FALLBACK_MODEL_ENV),
+	requiresApiKey: true,
+	isLocal: false,
+	usesResponsesApi: true,
+	providerOptions: getRouterProviderOptions,
+	agenticGeneration: {
+		callOptions: () => ({
+			providerOptions: getRouterProviderOptions('commit-message'),
+		}),
+	},
+};
