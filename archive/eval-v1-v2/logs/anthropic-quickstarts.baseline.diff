+# Requests go through Router's Anthropic Messages compatibility surface.
+# The Anthropic SDK appends "/v1/messages", so this resolves to
+# https://api.router.com/v1/messages (and /v1/messages/count_tokens).
+ROUTER_BASE_URL = os.environ.get("ROUTER_BASE_URL", "https://api.router.com")
+
+
+def _router_model_from_env() -> str:
+    """Read the Router model ID (from GET /v1/models) from ROUTER_MODEL."""
+    model = os.environ.get("ROUTER_MODEL")
+    if not model:
+        raise RuntimeError(
+            "ROUTER_MODEL is not set. Set it to a model ID returned by "
+            "Router's GET /v1/models for your account."
+        )
+    return model
+
+
+def create_router_client() -> Anthropic:
+    """Create an Anthropic Messages client pointed at Router.
+
+    Router authenticates with `Authorization: Bearer $RAMP_ROUTER_API_KEY`
+    and holds the provider credentials, so no provider API key is sent.
+    """
+    return Anthropic(
+        base_url=ROUTER_BASE_URL,
+        auth_token=os.environ.get("RAMP_ROUTER_API_KEY"),
+        # Never forward a provider key, even if ANTHROPIC_API_KEY is set.
+        default_headers={"X-Api-Key": Omit()},
+    )
+
+
