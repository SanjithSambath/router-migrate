+def router_extra_body(default_metadata: dict[str, str] | None = None) -> dict[str, Any]:
+    """Router-only request fields, sent through the OpenAI SDK's ``extra_body``.
+
+    Every field is opt-in via env so nothing is sent that the target model may
+    reject:
+      ROUTER_PROVIDER_TIMEOUT        -> provider_timeout (seconds per provider call)
+      ROUTER_TIMEOUT_BEFORE_HEADERS  -> timeout_before_headers (seconds to first stream event)
+      ROUTER_ALLOW_FLEX_TIER         -> allow_flex_tier (only set for Flex-eligible models; 400 otherwise)
+      ROUTER_METADATA                -> metadata (JSON object of short string labels, e.g.
+                                        {"feature": "research", "team": "search"})
+    ``models`` (ordered fallback list) is intentionally not wired up: it is
+    mutually exclusive with ``model``, which the LangChain client always sends.
+    """
+    extra: dict[str, Any] = {}
+
+    provider_timeout = _env_number("ROUTER_PROVIDER_TIMEOUT")
+    if provider_timeout is not None:
+        extra["provider_timeout"] = provider_timeout
+
+    timeout_before_headers = _env_number("ROUTER_TIMEOUT_BEFORE_HEADERS")
+    if timeout_before_headers is not None:
+        extra["timeout_before_headers"] = timeout_before_headers
+
+    allow_flex_tier = os.environ.get("ROUTER_ALLOW_FLEX_TIER")
+    if allow_flex_tier is not None and allow_flex_tier.strip() != "":
+        extra["allow_flex_tier"] = allow_flex_tier.strip().lower() in ("true", "1", "yes", "on")
+
+    metadata: dict[str, str] = dict(default_metadata or {})
+    raw_metadata = os.environ.get("ROUTER_METADATA")
+    if raw_metadata:
+        parsed = json.loads(raw_metadata)
