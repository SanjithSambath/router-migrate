+def model_in(model: str | None, models: list[str]) -> bool:
+    """Check a model against one of the per-model capability lists above.
+
+    Router model IDs are account-specific (from ``GET /v1/models``) and may
+    carry a ``provider:`` prefix (e.g. ``<provider>:<provider-model>``). Match
+    either the full ID or the part after the first ``:`` so the existing
+    temperature / reasoning-effort handling keeps applying to the same models.
+    """
+    if not model:
+        return False
+    if model in models:
+        return True
+    _, sep, provider_model = model.partition(":")
+    return bool(sep) and provider_model in models
+
+
+def _env_number(name: str) -> int | float | None:
+    raw = os.environ.get(name)
+    if raw is None or raw.strip() == "":
+        return None
+    value = float(raw)
+    return int(value) if value.is_integer() else value
+
