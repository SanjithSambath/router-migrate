+# All requests go through Router, which serves an Anthropic Messages
+# compatible surface at /v1/messages and /v1/messages/count_tokens, plus the
+# model list at /v1/models. Router holds the provider credentials: only the
+# Router key is ever sent.
+ROUTER_BASE_URL = "https://api.router.com/v1"
+ROUTER_KEY_ALIAS = "router"
+ROUTER_KEY_ENV_VAR = "RAMP_ROUTER_API_KEY"
+# JSON object mapping this plugin's Claude model IDs (e.g. "claude-sonnet-4-5")
+# to the account-specific Router model IDs returned by GET /v1/models
+ROUTER_MODELS_ENV_VAR = "RAMP_ROUTER_MODELS"
+
+
+def _sdk_base_url(base_url):
+    "The anthropic SDK appends /v1/... itself, so strip a trailing /v1"
+    base_url = base_url.rstrip("/")
+    if base_url.endswith("/v1"):
+        base_url = base_url[: -len("/v1")]
+    return base_url
+
+
+def router_client(key, base_url=None, async_=False):
+    """
+    An Anthropic SDK client pointed at Router's Messages compatibility
+    surface, authenticated with ``Authorization: Bearer <Router key>``
+    """
+    client_class = AsyncAnthropic if async_ else Anthropic
+    client = client_class(
+        auth_token=key, base_url=_sdk_base_url(base_url or ROUTER_BASE_URL)
+    )
+    # The SDK falls back to the ANTHROPIC_API_KEY environment variable and
+    # would send it as X-Api-Key - never send a provider key to Router
+    client.api_key = None
+    return client
+
+
+def _configured_router_models():
+    raw = os.environ.get(ROUTER_MODELS_ENV_VAR)
+    if not raw:
+        return {}
+    try:
+        mapping = json.loads(raw)
+    except ValueError:
+        raise llm.ModelError(f"{ROUTER_MODELS_ENV_VAR} must be a JSON object")
+    if not isinstance(mapping, dict) or not all(
+        isinstance(value, str) and value for value in mapping.values()
+    ):
+        raise llm.ModelError(
+            f"{ROUTER_MODELS_ENV_VAR} must be a JSON object mapping model IDs "
+            "to Router model ID strings"
+        )
+    return mapping
+
+
 # Settings for the newest generation of Claude models. Models this plugin
 # has no built-in entry for - listed by the anthropic SDK, or cached by
 # "llm anthropic refresh" - start from these, adjusted by any capabilities
