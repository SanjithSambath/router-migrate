@@ -0,0 +1,28 @@
+import OpenAI from "openai";
+
+// Router: an OpenAI Responses-compatible gateway in front of multiple providers.
+// Router holds the provider credentials; this app only ever sends RAMP_ROUTER_API_KEY.
+export const ROUTER_BASE_URL = "https://api.router.com/v1";
+
+export function getRouterClient(): OpenAI {
+  const apiKey = process.env.RAMP_ROUTER_API_KEY;
+  if (!apiKey) {
+    throw new Error("RAMP_ROUTER_API_KEY is not set");
+  }
+  return new OpenAI({
+    apiKey,
+    baseURL: ROUTER_BASE_URL,
+  });
+}
+
+// Model IDs are account-specific and must come from Router's `GET /v1/models`.
+// Set ROUTER_MODEL to one of those IDs; it is never hardcoded at call sites.
+export function getRouterModel(): string {
+  const model = process.env.ROUTER_MODEL;
+  if (!model) {
+    throw new Error(
+      "ROUTER_MODEL is not set (use a model ID returned by Router's GET /v1/models)"
+    );
+  }
+  return model;
+}
