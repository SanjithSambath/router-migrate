diff --git a/lib/ai/router.ts b/lib/ai/router.ts
new file mode 100644
index 0000000..5ad2278
--- /dev/null
+++ b/lib/ai/router.ts
@@ -0,0 +1,13 @@
+// Ramp Router: one OpenAI Responses-compatible API in front of many providers.
+// Router holds the provider credentials; this app only ever sends the Router key.
+export const ROUTER_BASE_URL = "https://api.router.com/v1";
+
+export function getRouterApiKey(): string {
+  const apiKey = process.env.RAMP_ROUTER_API_KEY;
+  if (!apiKey) {
+    // Fail loudly instead of letting the SDK fall back to a provider key
+    // (e.g. OPENAI_API_KEY) from the environment.
+    throw new Error("RAMP_ROUTER_API_KEY is not set");
+  }
+  return apiKey;
+}
