new file mode 100644
index 0000000..3298087
--- /dev/null
+++ b/backend/router_client.py
@@ -0,0 +1,105 @@
+"""Transport to Ramp's Router (https://api.router.com/v1).
+
+Router exposes one OpenAI Responses-compatible API (``POST /v1/responses``) in
+front of models from multiple providers, plus an Anthropic Messages
+compatibility surface (``POST /v1/messages``). It holds the provider
+credentials, so the only secret the app sends is ``RAMP_ROUTER_API_KEY``.
+
+Router model IDs are account-specific and come from ``GET /v1/models``. The app
+keeps its internal model catalog names (e.g. ``gpt-5.5``, ``claude-opus-5``,
+``gemini-3.6-flash``; used for pricing and logs) and maps each one to a Router
+model ID through an env var named ``ROUTER_MODEL_<CATALOG_NAME>``, e.g.
+``ROUTER_MODEL_GPT_5_5`` or ``ROUTER_MODEL_GEMINI_3_6_FLASH``.
+"""
+
+import os
+import re
+from typing import Any, Dict, Mapping, cast
+
+from anthropic import AsyncAnthropic, Omit
+from openai import AsyncOpenAI
+
+import config
+
+ROUTER_MODEL_ENV_PREFIX = "ROUTER_MODEL_"
+
+
+class RouterConfigError(Exception):
+    """Raised when Router credentials or model IDs are not configured."""
+
+
+def router_model_env_var(catalog_model_name: str) -> str:
+    """Env var holding the Router model ID for an internal catalog model name."""
+    suffix = re.sub(r"[^A-Z0-9]+", "_", catalog_model_name.upper()).strip("_")
+    return f"{ROUTER_MODEL_ENV_PREFIX}{suffix}"
+
+
+def get_router_model_id(catalog_model_name: str) -> str:
+    """Return the configured Router model ID for an internal catalog model name."""
+    env_var = router_model_env_var(catalog_model_name)
+    model_id = os.environ.get(env_var, "").strip()
+    if not model_id:
+        raise RouterConfigError(
+            f"No Router model configured for '{catalog_model_name}'. Set {env_var} "
+            f"to a model ID returned by GET {config.ROUTER_BASE_URL}/models."
+        )
+    return model_id
+
+
+def require_router_api_key(router_api_key: str | None) -> str:
+    if not router_api_key:
+        raise RouterConfigError(
+            "Router API key is missing. Set RAMP_ROUTER_API_KEY in backend/.env."
+        )
+    return router_api_key
+
+
+def create_router_responses_client(router_api_key: str | None) -> AsyncOpenAI:
+    """OpenAI Responses client pointed at Router (Authorization: Bearer <key>)."""
+    return AsyncOpenAI(
+        api_key=require_router_api_key(router_api_key),
+        base_url=config.ROUTER_BASE_URL,
+    )
+
+
+def _router_messages_base_url() -> str:
+    # The Anthropic SDK appends /v1/messages itself.
+    base_url = config.ROUTER_BASE_URL.rstrip("/")
+    return base_url[: -len("/v1")] if base_url.endswith("/v1") else base_url
+
+
+def create_router_messages_client(router_api_key: str | None) -> AsyncAnthropic:
+    """Anthropic Messages client pointed at Router's /v1/messages surface.
+
+    Router authenticates with ``Authorization: Bearer``, so the key goes in
+    ``auth_token``. The ``X-Api-Key`` header is explicitly omitted so an
+    ``ANTHROPIC_API_KEY`` left in the process environment is never forwarded.
+    """
+    return AsyncAnthropic(
+        auth_token=require_router_api_key(router_api_key),
+        base_url=_router_messages_base_url(),
+        default_headers=cast(Mapping[str, str], {"X-Api-Key": Omit()}),
+    )
+
+
+def _router_timeout_fields() -> Dict[str, Any]:
+    fields: Dict[str, Any] = {}
+    if config.ROUTER_PROVIDER_TIMEOUT is not None:
+        fields["provider_timeout"] = config.ROUTER_PROVIDER_TIMEOUT
+    if config.ROUTER_TIMEOUT_BEFORE_HEADERS is not None:
+        fields["timeout_before_headers"] = config.ROUTER_TIMEOUT_BEFORE_HEADERS
+    return fields
+
+
+def router_responses_extra_body(feature: str) -> Dict[str, Any]:
+    """Router-only fields for a /v1/responses request (sent via ``extra_body``)."""
+    return {"metadata": {"feature": feature}, **_router_timeout_fields()}
+
+
+def router_messages_extra_body() -> Dict[str, Any]:
+    """Router-only fields for a /v1/messages request (sent via ``extra_body``).
+
+    ``metadata`` is not sent here: on the Messages surface that field has the
+    Anthropic schema (``user_id``), not Router's spend-attribution labels.
+    """
+    return _router_timeout_fields()
