diff --git a/backend/tests/test_router_client.py b/backend/tests/test_router_client.py
new file mode 100644
index 0000000..b6a5023
--- /dev/null
+++ b/backend/tests/test_router_client.py
@@ -0,0 +1,83 @@
+import pytest
+from anthropic import Omit
+
+from router_client import (
+    RouterConfigError,
+    create_router_messages_client,
+    create_router_responses_client,
+    get_router_model_id,
+    router_messages_extra_body,
+    router_model_env_var,
+    router_responses_extra_body,
+)
+
+
+def test_router_model_env_var_normalizes_catalog_names() -> None:
+    assert router_model_env_var("gpt-5.5") == "ROUTER_MODEL_GPT_5_5"
+    assert (
+        router_model_env_var("gpt-5.4-2026-03-05")
+        == "ROUTER_MODEL_GPT_5_4_2026_03_05"
+    )
+    assert router_model_env_var("claude-opus-5-5") == "ROUTER_MODEL_CLAUDE_OPUS_5_5"
+    assert (
+        router_model_env_var("gemini-3.1-pro-preview")
+        == "ROUTER_MODEL_GEMINI_3_1_PRO_PREVIEW"
+    )
+
+
+def test_get_router_model_id_reads_env(monkeypatch: pytest.MonkeyPatch) -> None:
+    monkeypatch.setenv("ROUTER_MODEL_GPT_5_5", "acct-model-id")
+    assert get_router_model_id("gpt-5.5") == "acct-model-id"
+
+
+def test_get_router_model_id_requires_configuration(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    monkeypatch.delenv("ROUTER_MODEL_GPT_5_5", raising=False)
+    with pytest.raises(RouterConfigError, match="ROUTER_MODEL_GPT_5_5"):
+        get_router_model_id("gpt-5.5")
+
+
+def test_clients_require_router_key() -> None:
+    with pytest.raises(RouterConfigError, match="RAMP_ROUTER_API_KEY"):
+        create_router_responses_client(None)
+    with pytest.raises(RouterConfigError, match="RAMP_ROUTER_API_KEY"):
+        create_router_messages_client("")
+
+
+def test_responses_client_points_at_router() -> None:
+    client = create_router_responses_client("router-key")
+    assert str(client.base_url).rstrip("/") == "https://api.router.com/v1"
+    assert client.api_key == "router-key"
+
+
+def test_messages_client_uses_bearer_and_never_sends_provider_key(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    monkeypatch.setenv("ANTHROPIC_API_KEY", "provider-key-must-not-leak")
+    client = create_router_messages_client("router-key")
+    # The SDK appends /v1/messages to this base URL.
+    assert str(client.base_url).rstrip("/") == "https://api.router.com"
+    assert client.auth_token == "router-key"
+    assert isinstance(client.default_headers.get("X-Api-Key"), Omit)
+
+
+def test_router_extra_body_fields(monkeypatch: pytest.MonkeyPatch) -> None:
+    monkeypatch.setattr("config.ROUTER_PROVIDER_TIMEOUT", None)
+    monkeypatch.setattr("config.ROUTER_TIMEOUT_BEFORE_HEADERS", None)
+    assert router_responses_extra_body("codegen") == {
+        "metadata": {"feature": "codegen"}
+    }
+    assert router_messages_extra_body() == {}
+
+    monkeypatch.setattr("config.ROUTER_PROVIDER_TIMEOUT", 120.0)
+    monkeypatch.setattr("config.ROUTER_TIMEOUT_BEFORE_HEADERS", 30.0)
+    assert router_responses_extra_body("codegen") == {
+        "metadata": {"feature": "codegen"},
+        "provider_timeout": 120.0,
+        "timeout_before_headers": 30.0,
+    }
+    assert router_messages_extra_body() == {
+        "provider_timeout": 120.0,
+        "timeout_before_headers": 30.0,
+    }
