+from typing import Iterator
+
+import pytest
+
+from agent.providers.anthropic.provider import _get_anthropic_api_model_name
+from agent.providers.gemini import _get_gemini_api_model_name
+from llm import ANTHROPIC_MODELS, GEMINI_MODELS, OPENAI_MODELS, get_openai_api_name
+from router_client import router_model_env_var
+
+# Placeholder Router model IDs for offline tests. Real IDs are account-specific
+# and come from GET /v1/models.
+TEST_ROUTER_MODEL_PREFIX = "test-router/"
+
+
+def _catalog_model_names() -> set[str]:
+    names = {get_openai_api_name(model) for model in OPENAI_MODELS}
+    names |= {_get_anthropic_api_model_name(model) for model in ANTHROPIC_MODELS}
+    names |= {_get_gemini_api_model_name(model) for model in GEMINI_MODELS}
+    return names
+
+
+@pytest.fixture(autouse=True)
+def router_model_ids(monkeypatch: pytest.MonkeyPatch) -> Iterator[None]:
+    for name in _catalog_model_names():
+        monkeypatch.setenv(
+            router_model_env_var(name), f"{TEST_ROUTER_MODEL_PREFIX}{name}"
+        )
+    yield
