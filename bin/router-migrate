#!/usr/bin/env bash
# router-migrate launcher: uses the project venv when present, else python3 (needs libcst + httpx installed).
ROOT="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")/.." && pwd)"
PY="$ROOT/.venv/bin/python"; [ -x "$PY" ] || PY=python3
PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}" exec "$PY" -m router_migrate "$@"
