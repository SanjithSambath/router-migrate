#!/usr/bin/env bash
# router-migrate launcher. Uses the checkout's .venv when present (development); otherwise a cached venv with the runtime
# dependencies, created on first use (so the Claude Code plugin works from a fresh install). TS codemods need the checkout's
# node_modules; they are installed on first use when npm is available.
set -e
ROOT="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")/.." && pwd)"
PY="$ROOT/.venv/bin/python"
if [ ! -x "$PY" ]; then
  if python3 -c "import libcst, httpx" 2>/dev/null; then
    PY=python3
  else
    VENV="${ROUTER_MIGRATE_VENV:-${XDG_CACHE_HOME:-$HOME/.cache}/router-migrate/venv}"
    PY="$VENV/bin/python"
    if ! "$PY" -c "import libcst, httpx" 2>/dev/null; then
      echo "router-migrate: first run, installing libcst + httpx into $VENV ..." >&2
      if command -v uv >/dev/null 2>&1; then
        uv venv -q "$VENV" >&2 && uv pip install -q --python "$PY" "libcst>=1.1" "httpx>=0.27" >&2
      else
        python3 -m venv "$VENV" >&2 && "$PY" -m pip install -q --disable-pip-version-check "libcst>=1.1" "httpx>=0.27" >&2
      fi
    fi
  fi
fi
if [ ! -d "$ROOT/node_modules/ts-morph" ] && [ ! -e "$ROOT/.npm-tried" ] && command -v npm >/dev/null 2>&1 && [ -w "$ROOT" ]; then
  echo "router-migrate: first run, installing the TS codemod's node modules ..." >&2
  (cd "$ROOT" && npm ci --omit=dev --silent --no-audit --no-fund >/dev/null 2>&1) || touch "$ROOT/.npm-tried"
fi
PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}" exec "$PY" -m router_migrate "$@"
